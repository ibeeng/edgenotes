SHORTCUTS = [  # slug, nama, argumen, binding
    ("new", tr("EdgeNotes: catatan baru"), "--new", "<Super><Alt>n"),
    ("all", tr("EdgeNotes: semua catatan"), "--all", "<Super><Alt>a"),

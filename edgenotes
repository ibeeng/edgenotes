def continue_list(line):
    """Untuk Enter di baris daftar. Return None (bukan daftar),
    "" (item kosong → akhiri daftar) atau prefix item berikutnya."""
    m = LIST_RE.match(line)
    if not m:
        return None
    indent, marker, num, sep, content = m.groups()
    if not content.strip():
        return ""
    if num is not None:
        return f"{indent}{int(num) + 1}{sep} "
    if marker in ("☐", "☑"):
        return f"{indent}☐ "
    return f"{indent}• "


def fullscreen_blocks(is_fullscreen, is_normal, skip_tasklist, pid, my_pid, geom, monitor):
    """Apakah jendela aktif benar-benar aplikasi layar penuh yang menutupi strip?
    Jendela desktop/dock/panel, jendela milik EdgeNotes, atau jendela di monitor lain diabaikan."""
    if not is_fullscreen or not is_normal or skip_tasklist:
        return False
    if pid and pid == my_pid:
        return False
    gx, gy, gw, gh = geom
    mx, my, mw, mh = monitor
    return abs(gx - mx) <= 2 and abs(gy - my) <= 2 and gw >= mw - 2 and gh >= mh - 2


def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def lerp(a, b, t):
    return a + (b - a) * t


class Store:
    def __init__(self, directory=None):
        self.dir = directory or data_dir()
        os.makedirs(self.dir, exist_ok=True)
        self.notes_path = os.path.join(self.dir, "notes.json")
        self.config_path = os.path.join(self.dir, "config.json")
        raw = self._read_json(self.notes_path, {"notes": []})
        notes = raw.get("notes", []) if isinstance(raw, dict) else []
        self.notes = [self._normalize(n) for n in notes if isinstance(n, dict)]
        self._fix_ids()
        cfg = self._read_json(self.config_path, {})
        self.config = dict(DEFAULT_CONFIG)
        if isinstance(cfg, dict):
            self.config.update({k: v for k, v in cfg.items() if k in DEFAULT_CONFIG})
        if self.config["side"] not in ("left", "right"):
            self.config["side"] = "right"
        if isinstance(cfg, dict) and int(cfg.get("schema", 0) or 0) < 3:
            # v2.1: default pindah ke font sistem; catatan lama bergaya tulisan tangan ikut default
            self.config["font"] = "system"
            if cfg.get("font_size") in (None, 13, 14):
                self.config["font_size"] = 11
            for n in self.notes:
                if n["font"] == "hand":
                    n["font"] = None
            self.config["schema"] = 3
            self._migrated = True
        if self.config["font"] not in FONTS:
            self.config["font"] = "system"
        if getattr(self, "_migrated", False):
            try:
                self.save_config()
                if self.notes:
                    self.save()
            except OSError:
                pass
        if self.config["theme"] not in ("auto", "light", "dark"):
            self.config["theme"] = "auto"
        if self.config["sort"] not in SORTS:
            self.config["sort"] = "manual"

    # ---- io ----
    @staticmethod
    def _read_json(path, default):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return json.load(f)
        except FileNotFoundError:
            return default
        except (OSError, ValueError):
            try:
                shutil.copy2(path, f"{path}.corrupt-{int(time.time())}")
            except OSError:
                pass
            return default

    @staticmethod
    def _write_json(path, data):
        d = os.path.dirname(path) or "."
        fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=d)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=1)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, path)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise

    def save(self):
        if os.path.exists(self.notes_path):
            try:
                shutil.copy2(self.notes_path, self.notes_path + ".bak")
            except OSError:
                pass
        self._write_json(self.notes_path, {"version": 2, "notes": self.notes})

    def save_config(self):
        self._write_json(self.config_path, self.config)

    # ---- model ----
    @staticmethod
    def _normalize(n):
        now = time.time()
        created = float(n.get("created", now))
        fl = n.get("float")
        if not (isinstance(fl, list) and len(fl) == 4 and all(isinstance(v, (int, float)) for v in fl)):
            fl = None
        return {
            "id": str(n.get("id") or uuid.uuid4()),
            "text": str(n.get("text", "")),
            "color": n.get("color") if n.get("color") in PALETTE else "yellow",
            "font": n.get("font") if n.get("font") in FONTS else None,
            "order": float(n.get("order", created)),
            "archived": bool(n.get("archived", False)),
            "pinned": bool(n.get("pinned", False)),       # jendela editor selalu di atas
            "top": bool(n.get("top", False)),             # disematkan di atas strip
            "group": str(n.get("group") or "")[:40],
            "reminder": float(n["reminder"]) if isinstance(n.get("reminder"), (int, float)) else None,
            "reminded": bool(n.get("reminded", False)),
            "images": [str(x) for x in n.get("images", []) if isinstance(x, str)][:20],
            "history": [h for h in n.get("history", []) if isinstance(h, dict)
                        and isinstance(h.get("text"), str) and isinstance(h.get("t"), (int, float))][-HISTORY_MAX:],
            "float": [int(v) for v in fl] if fl else None,
            "created": created,
            "updated": float(n.get("updated", created)),
        }

    def _fix_ids(self):
        seen = set()
        for n in self.notes:
            if n["id"] in seen:
                n["id"] = str(uuid.uuid4())
            seen.add(n["id"])

    def _max_order(self):
        return max((n["order"] for n in self.notes), default=0.0)

    def next_color(self):
        used = {n["color"] for n in self.notes if not n["archived"]}
        for c in COLORS[:-1]:
            if c not in used:
                return c
        return COLORS[len(self.notes) % (len(COLORS) - 1)]

    def new_note(self, color=None, text="", font=None, top=True):
        now = time.time()
        n = self._normalize({"text": text, "color": color or self.next_color(),
                             "font": font, "created": now, "updated": now})
        if top and self.notes:  # catatan baru muncul paling atas
            n["order"] = min(x["order"] for x in self.notes) - 1
        else:
            n["order"] = self._max_order() + 1
        self.notes.append(n)
        return n

    def get(self, note_id):
        for n in self.notes:
            if n["id"] == note_id:
                return n
        return None

    def font_of(self, n):
        return n.get("font") or self.config["font"]

    def update(self, note_id, **fields):
        n = self.get(note_id)
        if n is None:
            return None
        changed = False
        now = time.time()
        if "text" in fields and fields["text"] != n["text"] and n["text"].strip():
            hist = n.setdefault("history", [])
            if not hist or now - hist[-1]["t"] >= HISTORY_EVERY:
                hist.append({"t": now, "text": n["text"]})
                del hist[:-HISTORY_MAX]
        for k, v in fields.items():
            if k in ("text", "color", "font", "float", "pinned", "top", "group",
                     "reminder", "reminded", "images") and n.get(k) != v:
                n[k] = v
                changed = True
        if changed and "text" in fields:
            n["updated"] = now
        if "reminder" in fields:
            n["reminded"] = False
        return n

    def restore_version(self, note_id, index):
        """Kembalikan isi ke versi lama; isi sekarang ikut masuk riwayat."""
        n = self.get(note_id)
        if n is None or not (0 <= index < len(n["history"])):
            return None
        old = n["history"][index]["text"]
        n["history"].append({"t": time.time(), "text": n["text"]})
        del n["history"][:-HISTORY_MAX]
        n["text"] = old
        n["updated"] = time.time()
        return n

    def groups(self):
        return sorted({n["group"] for n in self.notes if n["group"]}, key=str.casefold)

    def due_reminders(self, now=None):
        now = now if now is not None else time.time()
        return [n for n in self.notes if n["reminder"] and not n["reminded"]
                and not n["archived"] and n["reminder"] <= now]

    def next_reminder(self):
        pending = [n["reminder"] for n in self.notes
                   if n["reminder"] and not n["reminded"] and not n["archived"]]
        return min(pending) if pending else None

    def search(self, text, limit=8):
        q = (text or "").casefold().strip()
        if not q:
            return []
        hits = []
        for n in self.notes:
            if n["archived"]:
                continue
            t = n["text"].casefold()
            title = note_title(n["text"]).casefold()
            if q in t or q in n["group"].casefold():
                score = (0 if title.startswith(q) else 1 if q in title else 2, -n["updated"])
                hits.append((score, n))
        hits.sort(key=lambda h: h[0])
        return [n for _s, n in hits[:limit]]

    # ---- gambar ----
    def images_dir(self):
        d = os.path.join(self.dir, "images")
        os.makedirs(d, exist_ok=True)
        return d

    def add_image_bytes(self, note_id, png_bytes):
        n = self.get(note_id)
        if n is None:
            return None
        name = f"{note_id[:8]}-{uuid.uuid4().hex[:8]}.png"
        with open(os.path.join(self.images_dir(), name), "wb") as f:
            f.write(png_bytes)
        n["images"].append(name)
        n["updated"] = time.time()
        return name

    def remove_image(self, note_id, name):
        n = self.get(note_id)
        if n is None or name not in n["images"]:
            return False
        n["images"].remove(name)
        return True

    def delete(self, note_id):
        """Hapus; kembalikan salinan catatan untuk undo."""
        n = self.get(note_id)
        if n is None:
            return None
        self.notes = [x for x in self.notes if x["id"] != note_id]
        return dict(n)

    def restore(self, note):
        if note and self.get(note["id"]) is None:
            self.notes.append(self._normalize(note))
            return True
        return False

    def set_archived(self, note_id, archived):
        n = self.get(note_id)
        if n is None or n["archived"] == archived:
            return None
        n["archived"] = archived
        if archived:
            n["float"] = None
        else:
            n["order"] = self._max_order() + 1
        return n

    def all_tabs(self):
        """Semua catatan aktif: yang disematkan dulu, lalu urutan manual."""
        return sorted((n for n in self.notes if not n["archived"]),
                      key=lambda n: (not n["top"], n["order"]))

    def tabs(self):
        """Catatan di strip (mengikuti filter grup)."""
        g = self.config.get("group_filter") or ""
        items = self.all_tabs()
        return [n for n in items if n["group"] == g] if g else items

    def move(self, note_id, new_index, scope="strip"):
        # rapikan nilai order dulu supaya unik
        for i, n in enumerate(sorted(self.notes, key=lambda n: n["order"])):
            n["order"] = float(i)
        items = self.tabs() if scope == "strip" else self.all_tabs()
        ids = [n["id"] for n in items]
        if note_id not in ids:
            return False
        old = ids.index(note_id)
        n_top = sum(1 for n in items if n["top"])
        if items[old]["top"]:
            new_index = min(new_index, n_top - 1)
        else:
            new_index = max(new_index, n_top)
        new_index = max(0, min(new_index, len(ids) - 1))
        if old == new_index:
            return False
        slots = sorted(n["order"] for n in items)   # posisi catatan tersembunyi tidak berubah
        item = items.pop(old)
        items.insert(new_index, item)
        for n, v in zip(items, slots):
            n["order"] = v
        return True

    def latest(self, include_archived=False):
        pool = [n for n in self.notes if include_archived or not n["archived"]]
        return max(pool, key=lambda n: n["updated"]) if pool else None

    def query(self, text="", sort="manual", archived=False):
        q = (text or "").casefold().strip()
        items = [n for n in self.notes
                 if n["archived"] == archived and (not q or q in n["text"].casefold()
                                                   or q in n.get("group", "").casefold())]
        if sort == "updated":
            items.sort(key=lambda n: n["updated"], reverse=True)
        elif sort == "created":
            items.sort(key=lambda n: n["created"], reverse=True)
        elif sort == "title":
            items.sort(key=lambda n: note_title(n["text"]).casefold())
        elif sort == "color":
            items.sort(key=lambda n: (COLORS.index(n["color"]), n["order"]))
        else:
            items.sort(key=lambda n: (not n.get("top"), n["order"]))
        return items

    # ---- impor / ekspor ----
    def export_json(self):
        return {"app": "edgenotes", "version": 2, "exported": time.time(),
                "notes": [dict(n) for n in self.notes]}

    def import_json(self, data):
        notes = data.get("notes") if isinstance(data, dict) else data
        if not isinstance(notes, list):
            raise ValueError(tr("Bukan file cadangan EdgeNotes"))
        count = 0
        base = self._max_order()
        for raw in notes:
            if not isinstance(raw, dict):
                continue
            n = self._normalize(raw)
            existing = self.get(n["id"])
            if existing is not None:
                if existing["text"] == n["text"]:
                    continue  # sudah ada
                n["id"] = str(uuid.uuid4())
            count += 1
            n["order"] = base + count
            n["float"] = None
            self.notes.append(n)
        return count

    def import_text(self, text):
        text = (text or "").strip("\n")
        if not text.strip():
            return None
        return self.new_note(text=text)

    def export_markdown(self):
        out = ["# EdgeNotes", ""]
        for archived in (False, True):
            items = self.query(sort="manual", archived=archived)
            if archived and items:
                out += [tr("# Arsip"), ""]
            for n in items:
                t = time.strftime("%Y-%m-%d %H:%M", time.localtime(n["updated"]))
                out += [f"## {note_title(n['text'])}", tr("_Diperbarui {t}_").format(t=t), "",
                        n["text"].rstrip(), "", "---", ""]
        return "\n".join(out)



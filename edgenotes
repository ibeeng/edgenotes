        def _draw_bg(self, w, cr):
            n = store.get(self.nid)
            W, H = w.get_allocated_width(), w.get_allocated_height()
            draw_card(cr, SH, SH, W - 2 * SH, H - 2 * SH, n["color"] if n else "yellow")
            ink = (1, 1, 1) if TH["dark"] else (0, 0, 0)
            cr.set_source_rgba(*ink, 0.10)
            cr.set_line_width(1)
            cr.move_to(SH + 14, SH + self.HEAD_H + 0.5)
            cr.line_to(W - SH - 14, SH + self.HEAD_H + 0.5)
            cr.stroke()
            return False

        def _shape(self):
            if self.get_window() is None:
                return
            w, h = self.get_allocated_width(), self.get_allocated_height()
            rects = [(SH // 2, SH // 2, w - SH, h - SH)]
            if rects != self._regions:
                self._regions = rects
                self.input_shape_combine_region(region_from(rects))
                if not self.composited:
                    self.shape_combine_region(region_from(rects))

        def _head_press(self, _w, ev):
            if ev.button == 1 and ev.type == Gdk.EventType.BUTTON_PRESS:
                self.begin_move_drag(1, int(ev.x_root), int(ev.y_root), ev.time)
                return True
            return False

        def _grip_press(self, _w, ev):
            if ev.button == 1:
                self.begin_resize_drag(Gdk.WindowEdge.SOUTH_EAST, 1,
                                       int(ev.x_root), int(ev.y_root), ev.time)
            return True

        def _on_configure(self, *_):
            x, y = self.get_position()
            w, h = self.get_size()
            self.geom = [int(x), int(y), int(w), int(h)]
            return False


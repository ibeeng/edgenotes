            self.get_style_context().add_class("en-search")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            for side in ("top", "bottom", "start", "end"):
                getattr(box, f"set_margin_{side}")(10)
            self.entry = Gtk.SearchEntry()
            self.entry.set_placeholder_text(tr("Cari catatan… (judul, isi, grup)"))
            self.entry.connect("search-changed", lambda *_: self.refresh())
            self.entry.connect("activate", lambda *_: self._open_selected())
            box.pack_start(self.entry, False, False, 0)
            self.lb = Gtk.ListBox()
            self.lb.set_activate_on_single_click(True)
            self.lb.connect("row-activated", lambda _l, r: self._open(r))
            box.pack_start(self.lb, False, False, 0)
            self.hint = Gtk.Label(xalign=0)
            self.hint.get_style_context().add_class("dim-label")
            box.pack_start(self.hint, False, False, 0)
            self.add(box)
            self.connect("key-press-event", self._key)
            self.connect("focus-out-event", lambda *_: GLib.timeout_add(150, self._maybe_close))
            self.refresh()

        def _maybe_close(self):
            if not self.is_active() and self.get_visible():
                self.destroy()
            return False

        def refresh(self):
            for c in self.lb.get_children():
                c.destroy()
            q = self.entry.get_text().strip()
            if q:
                items = store.search(q, 8)
            else:
                items = sorted(store.all_tabs(), key=lambda n: -n["updated"])[:6]
            for n in items:
                self.lb.add(self._row(n))
            if q:
                row = Gtk.ListBoxRow()
                row.nid = None
                row.new_text = q
                lab = Gtk.Label(label=tr("＋ Catatan baru: “{q}”").format(q=q[:40]), xalign=0)
                for side in ("top", "bottom", "start", "end"):
                    getattr(lab, f"set_margin_{side}")(8)
                lab.get_style_context().add_class("dim-label")
                row.add(lab)
                self.lb.add(row)
            self.hint.set_text((tr("Tidak ketemu. ") if q and not items else
                                "" if q else tr("Terakhir diedit · ")) + tr("↑↓ pilih · Enter buka · Esc tutup"))
            self.lb.show_all()
            first = self.lb.get_row_at_index(0)
            if first is not None:
                self.lb.select_row(first)
            self.resize(520, 1)

        def _row(self, n):
            row = Gtk.ListBoxRow()
            row.nid = n["id"]
            h = Gtk.Box(spacing=10)
            for side in ("top", "bottom", "start", "end"):
                getattr(h, f"set_margin_{side}")(6)
            sw = Gtk.DrawingArea()
            sw.set_size_request(6, 30)
            sw.connect("draw", lambda _w, cr, c=n["color"]: NotesPage._draw_swatch(_w, cr, c))
            h.pack_start(sw, False, False, 0)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            t = Gtk.Label(label=note_title(n["text"]), xalign=0)
            t.set_ellipsize(Pango.EllipsizeMode.END)
            at = Pango.AttrList()
            at.insert(Pango.attr_weight_new(Pango.Weight.BOLD))
            t.set_attributes(at)
            v.pack_start(t, False, False, 0)
            snip = note_snippet(n["text"])
            q = self.entry.get_text().strip().casefold()
            if q:   # tunjukkan baris yang cocok, bukan cuma awal catatan
                for line in n["text"].splitlines()[1:]:
                    if q in line.casefold():
                        snip = line.strip()
                        break
            if snip:
                sl = Gtk.Label(label=snip, xalign=0)
                sl.set_ellipsize(Pango.EllipsizeMode.END)
                sl.get_style_context().add_class("dim-label")
                v.pack_start(sl, False, False, 0)
            h.pack_start(v, True, True, 0)
            meta = " · ".join(x for x in (n["group"], human_time(n["updated"])) if x)
            m = Gtk.Label(label=meta)
            m.get_style_context().add_class("dim-label")
            h.pack_end(m, False, False, 0)
            row.add(h)
            return row

        def _key(self, _w, ev):
            key = Gdk.keyval_name(ev.keyval) or ""
            if key == "Escape":
                self.destroy()
                return True
            if key in ("Down", "Up"):
                rows = self.lb.get_children()
                if not rows:
                    return True
                cur = self.lb.get_selected_row()
                i = rows.index(cur) if cur in rows else -1
                i = max(0, min(len(rows) - 1, i + (1 if key == "Down" else -1)))
                self.lb.select_row(rows[i])
                return True
            return False

        def _open_selected(self):
            row = self.lb.get_selected_row()
            if row is not None:
                self._open(row)

        def _open(self, row):
            if row.nid:
                nid = row.nid
                self.destroy()
                self.ctl.open_editor(nid)
            elif getattr(row, "new_text", None):
                text = row.new_text
                self.destroy()
                self.ctl.new_note(text=text)


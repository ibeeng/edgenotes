def data_dir():
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, "edgenotes")


def _first_line(text):
    for line in (text or "").splitlines():
        line = line.strip().lstrip("#").strip()
        line = re.sub(r"^(•|☐|☑|\d+[.)])\s*", "", line)
        if line:
            return line
    return ""


def note_title(text):
    return _first_line(text)[:80] or tr("Catatan kosong")


def tab_label(text):
    line = _first_line(text).upper()
    if not line:
        return tr("BARU")
    done, total = checklist_progress(text)
    room = 11 if total else 14
    line = line if len(line) <= room else line[:room - 1].rstrip() + "…"
    return f"{line} · {done}/{total}" if total else line


def note_snippet(text):
    lines = [l.strip() for l in (text or "").splitlines() if l.strip()]
    return " ".join(lines[1:])[:140]


def human_time(ts, now=None):
    now = now if now is not None else time.time()
    d = now - ts
    if d < 60:
        return tr("baru saja")
    if d < 3600:
        return tr("{n} mnt lalu").format(n=int(d // 60))
    if d < 86400:
        return tr("{n} jam lalu").format(n=int(d // 3600))
    if d < 2 * 86400:
        return tr("kemarin")
    t = time.localtime(ts)
    return f"{t.tm_mday} {month_name(t.tm_mon - 1)} {t.tm_year}"


HISTORY_MAX = 30

        # ---------- pengingat ----------
        def ring_note(self, nid):
            self.ring[nid] = GLib.get_monotonic_time() / 1e6
            if not self._ring_id:
                self._ring_id = self.strip.add_tick_callback(self._ring_tick)
            self.strip.queue_draw()

        def unring(self, nid):
            if self.ring.pop(nid, None) is not None:
                self.strip.queue_draw()

        def _ring_tick(self, _w, _clock):
            now = GLib.get_monotonic_time() / 1e6
            self.strip.queue_draw()
            if all(now - t > RING_SECONDS for t in self.ring.values()):
                self._ring_id = 0
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE

        def _shake(self, nid):
            t0 = self.ring.get(nid)
            if t0 is None:
                return 0.0
            t = GLib.get_monotonic_time() / 1e6 - t0
            if t > RING_SECONDS:
                return 0.0
            return math.sin(t * 2 * math.pi * 6) * 3.5 * (1 - t / RING_SECONDS)

        def _badge(self, cr, x, y, a=1.0):
            cr.new_path()
            cr.arc(x, y, 3.6, 0, 2 * math.pi)
            cr.set_source_rgba(0.90, 0.28, 0.30, a)
            cr.fill_preserve()
            cr.set_source_rgba(1, 1, 1, 0.9 * a)
            cr.set_line_width(1.2)
            cr.stroke()

        # ---------- jaga supaya strip tidak hilang ----------
        def _on_realize(self, *_):
            gw = self.get_window()
            try:
                gw.set_group(gw)
            except Exception:
                pass
            self.update_shape(force=True)

        def _on_state(self, _w, ev):
            if ev.new_window_state & Gdk.WindowState.ICONIFIED:
                log("strip di-minimize oleh window manager → dikembalikan")
                GLib.idle_add(self._restore)
            return False

        def _on_unmap(self, *_):
            if not self.ctl.strip_hidden():
                log("strip disembunyikan tanpa diminta → dikembalikan")
                GLib.timeout_add(150, self._restore)
            return False

        def _restore(self):
            if self.ctl.strip_hidden():
                return False
            self.deiconify()
            self.show()
            self.set_keep_above(True)
            self.stick()
            self.place()
            return False

        # ---------- koordinat: jarak dari tepi layar ----------
        def _right(self):
            return self.cfg["side"] == "right"

        def _W(self):
            w = self.strip.get_allocated_width()
            return w if w > 1 else self._win_w

        def _H(self):
            h = self.strip.get_allocated_height()
            return h if h > 1 else self._win_h

        def _span(self, W, inner, outer):
            if self._right():
                return W - inner, inner - outer
            return outer, inner - outer

        def _ex(self, W, dist):
            return W - dist if self._right() else dist

        def _dist(self, x):
            return self._W() - x if self._right() else x

        # ---------- teks ----------
        def _make_label(self, text, max_w):
            layout = self.strip.create_pango_layout(text)
            layout.set_font_description(Pango.FontDescription("Sans Bold 6.5"))
            attrs = Pango.AttrList()
            attrs.insert(Pango.attr_letter_spacing_new(int(1.3 * Pango.SCALE)))
            layout.set_attributes(attrs)
            tw, _ = layout.get_pixel_size()
            if tw > max_w:
                layout.set_width(int(max_w) * Pango.SCALE)
                layout.set_ellipsize(Pango.EllipsizeMode.END)
            return layout

        def _label_layout(self, n):
            text = tab_label(n["text"])
            c = self._layout_cache.get(n["id"])
            if c and c[0] == text:
                return c
            layout = self._make_label(text, 100)
            tw, th = layout.get_pixel_size()
            c = (text, layout, tw, th)
            self._layout_cache[n["id"]] = c
            return c

        def _card_text(self, n):
            """Layout judul + isi untuk kartu intip (di-cache per isi/font)."""
            font = store.font_of(n)
            key = (n["text"], font, TH["dark"])
            c = self._text_cache.get(n["id"])
            if c and c[0] == key:
                return c[1], c[2]
            title, _, body = n["text"].partition("\n")
            title = title.strip() or note_title(n["text"])
            tw = (CARD_W - CARD_BAND - 26) * Pango.SCALE
            tl = self.strip.create_pango_layout(title)
            tl.set_font_description(Pango.FontDescription("Sans Bold 10.5"))
            tl.set_width(tw)
            tl.set_ellipsize(Pango.EllipsizeMode.END)
            bl = self.strip.create_pango_layout(body.strip("\n"))
            fam = FONTS[font][1]
            fd = Pango.FontDescription("Sans 10")
            if fam:
                fd.set_family(fam.replace('"', ""))
                fd.set_size(int((11 if font == "hand" else 10) * Pango.SCALE))
            bl.set_font_description(fd)
            bl.set_width(tw)
            bl.set_wrap(Pango.WrapMode.WORD_CHAR)
            bl.set_ellipsize(Pango.EllipsizeMode.END)
            bl.set_height(-(max(1, (CARD_H - 80) // 16)))   # batas jumlah baris (+ baris info)
            self._text_cache[n["id"]] = (key, tl, bl)
            return tl, bl

        def _card_info(self, n):
            parts = []
            if n["reminder"] and not n["reminded"]:
                parts.append("⏰ " + fmt_reminder(n["reminder"]))
            if n["group"]:
                parts.append(n["group"].upper())
            done, total = checklist_progress(n["text"])
            if total:
                parts.append(f"☑ {done}/{total}")
            if n["images"]:
                parts.append(f"🖼 {len(n['images'])}")
            return "  ·  ".join(parts)

        # ---------- geometri ----------
        def rest_geom(self):
            notes = store.tabs()
            H = self._H()
            n = max(1, len(notes))
            dh, dg = DASH_H, DASH_GAP
            room = H - 16 - REST_PAD * 2
            if n * dh + (n - 1) * dg > room:      # banyak catatan: garis dipadatkan
                unit = room / max(1, n * 1.5 - 0.5)
                dh, dg = max(3.0, unit), max(1.5, unit * 0.5)
            self._dash_h = dh
            ph = REST_PAD * 2 + n * dh + (n - 1) * dg
            top = (H - ph) / 2
            dashes = [(note, top + REST_PAD + i * (dh + dg)) for i, note in enumerate(notes)]
            return top, ph, dashes

        def _base_h(self, n):
            return max(TAB_MIN_H, self._label_layout(n)[2] + 26 + (12 if n["top"] else 0))

        def _filter_layout(self):
            g = self.cfg.get("group_filter") or ""
            if not g:
                return None
            c = self._layout_cache.get(("filter", g))
            if c is None:
                layout = self._make_label(g.upper(), 90)
                tw, th = layout.get_pixel_size()
                c = self._layout_cache[("filter", g)] = (layout, tw, th)
            return c

        def _filter_extra(self):
            c = self._filter_layout()
            return (BTN_GAP + c[1] + 30) if c else 0

        def _expand(self, nid):
            if nid is not None and nid == self.slot_cur:
                return self.slot_t
            if nid is not None and nid == self.slot_prev:
                return 1.0 - self.slot_t
            return 0.0

        def open_geom(self):
            """[(catatan, y, tinggi, e)], (cx, cy) tombol +, (atas, bawah).
            e = 0 tab biasa … 1 kartu penuh. Tombol + dan ⚙ SELALU dapat tempat:
            kalau catatan banyak, tab dipendekkan dulu, lalu ditumpuk lebih rapat."""
            notes = store.tabs()
            n = len(notes)
            H = self._H()
            base = [self._base_h(x) for x in notes]
            exp = [self._expand(x["id"]) for x in notes]
            extra = (PLUS_GAP if notes else 0) + PLUS_D + BTN_GAP + SET_D + self._filter_extra()
            avail = H - 8 - extra                       # ruang untuk tumpukan tab
            card_h = min(CARD_H, max(120, avail - (n - 1) * TAB_PEEK_MIN - 8))

            def stack_for(k, ov):
                hs = [max(TAB_MIN_COMPACT, b * k) for b in base]
                hs = [lerp(h, card_h, e) for h, e in zip(hs, exp)]
                return hs, sum(hs) - ov * max(0, n - 1)

            k, ov = 1.0, float(TAB_OVERLAP)
            heights, stack = stack_for(k, ov)
            if stack > avail and n:
                lo, hi = 0.0, 1.0                       # 1) pendekkan tab
                for _ in range(18):
                    mid = (lo + hi) / 2
                    if stack_for(mid, ov)[1] <= avail:
                        lo = mid
                    else:
                        hi = mid
                k = lo
                heights, stack = stack_for(k, ov)
                if stack > avail and n > 1:             # 2) tumpuk lebih rapat
                    need = (stack - avail) / (n - 1)
                    shortest = min(h for h, e in zip(heights, exp) if e < 0.5) if any(e < 0.5 for e in exp) else TAB_MIN_COMPACT
                    ov = min(ov + need, max(TAB_OVERLAP, shortest - TAB_PEEK_MIN))
                    heights, stack = stack_for(k, ov)
            self._tab_scale, self._tab_ov = k, ov
            closed = sum(max(TAB_MIN_COMPACT, b * k) for b in base) - ov * max(0, n - 1)
            closed_top = max(4, (H - closed - extra) / 2)
            block = stack + extra
            top = max(4, min(closed_top, H - block - 4))
            tabs, y = [], top
            for x, h, e in zip(notes, heights, exp):
                tabs.append((x, y, h, e))
                y += h - ov
            plus_cy = top + stack + (PLUS_GAP if notes else 0) + PLUS_D / 2
            self._set_cy = plus_cy + PLUS_D / 2 + BTN_GAP + SET_D / 2
            fh = self._filter_extra()
            self._filt_h = fh - BTN_GAP
            self._filt_cy = self._set_cy + SET_D / 2 + BTN_GAP + self._filt_h / 2
            return tabs, (TAB_W / 2 + 2, plus_cy), (top, top + block)

        def _needed_h(self):
            """Tinggi jendela secukupnya: tumpukan tab + satu kartu terbuka + tombol."""
            notes = store.tabs()
            base = [self._base_h(n) for n in notes]
            stack = sum(base) - TAB_OVERLAP * max(0, len(notes) - 1)
            if base:
                stack += CARD_H - min(base)
            extra = (PLUS_GAP if notes else 0) + PLUS_D + BTN_GAP + SET_D + self._filter_extra()
            wa = primary_monitor().get_workarea()
            return int(max(180, min(stack + extra + 32, wa.height - 16)))

        def _inner(self, i, e, hov=False):
            """Lebar bentuk (dari tepi layar): tab → kartu."""
            base = TAB_W + (4 if hov and e < 0.05 else 0)
            return lerp(base, CARD_W, e)

        def _fan_total(self):
            return TAB_DUR + TAB_STAGGER * (max(0, len(store.tabs())) + (1 if self.cfg.get("group_filter") else 0))

        def _tab_p(self, i):
            el = self.fan * self._fan_total()
            p = max(0.0, min(1.0, (el - i * TAB_STAGGER) / TAB_DUR))
            return 1 - (1 - p) ** 3

        # ---------- animasi ----------
        def _set_fan(self, v):
            self.fan = v
            self.update_shape()
            self.strip.queue_draw()
            if v <= 0:
                self._maybe_compact()

        def _set_slot_t(self, v):
            self.slot_t = v
            if v >= 1.0 and self.slot_prev is not None and self.slot_cur is None:
                self.slot_prev = None
            self.update_shape()
            self.strip.queue_draw()
            if v >= 1.0:
                self._maybe_compact()

        def _expand_window(self):
            if self.compact:
                self.compact = False
                self.place()

        def _maybe_compact(self):
            if (not self.compact and self.fan <= 0 and self.fan_target <= 0
                    and self.slot_cur is None and self.slot_prev is None and not self.drag
                    and not self._disp_y):
                self.compact = True
                self.place()

        def open_fan(self):
            self._expand_window()
            self.fan_target = 1.0
            self.fan_anim.to(1.0, int((1.0 - self.fan) * self._fan_total()))
            self.update_shape()

        def close_fan(self):
            self.fan_target = 0.0
            self.fan_anim.to(0.0, int(self.fan * self._fan_total()))

        def relayout(self):
            if abs(self._needed_h() - self._win_h) > 2:
                self.place()
            self.update_shape()
            self.strip.queue_draw()

        def invalidate_labels(self):
            self._layout_cache.clear()
            self._text_cache.clear()
            self.relayout()

        def refresh_card(self):
            self._text_cache.pop(self.card_id, None)
            self.strip.queue_draw()

        # ---------- gambar ----------
        def _draw(self, w, cr):
            W = w.get_allocated_width()
            dark = TH["dark"]
            right = self._right()
            el = self.fan * self._fan_total()
            rest_a = max(0.0, 1.0 - el / 110.0)

            if rest_a > 0:
                top, ph, dashes = self.rest_geom()
                x, wd = self._span(W, REST_MARGIN + REST_W, REST_MARGIN)
                rrect(cr, x, top, wd, ph, REST_W / 2)
                cr.set_source_rgba(0.22, 0.22, 0.27, 0.62 * rest_a)
                cr.fill_preserve()
                cr.set_source_rgba(1, 1, 1, 0.14 * rest_a)
                cr.set_line_width(1)
                cr.stroke()
                mid = REST_MARGIN + REST_W / 2
                dx, dw = self._span(W, mid + DASH_W / 2, mid - DASH_W / 2)
                if not dashes:
                    rrect(cr, dx, top + REST_PAD, dw, self._dash_h, DASH_W / 2)
                    cr.set_source_rgba(1, 1, 1, 0.35 * rest_a)
                    cr.fill()
                for n, dy in dashes:
                    sx = self._shake(n["id"])
                    rrect(cr, dx + sx, dy, dw, self._dash_h, min(DASH_W / 2, self._dash_h / 2))
                    cr.set_source_rgba(*hex_rgb(PALETTE[n["color"]][0]), rest_a)
                    cr.fill()
                    if n["id"] in self.ring:
                        self._badge(cr, self._ex(W, REST_MARGIN + REST_W + 5) + sx,
                                    dy + self._dash_h / 2, rest_a)

            if self.fan <= 0:
                return True

            tabs, (pcx, pcy), _ = self.open_geom()
            ink = (1, 1, 1) if dark else (0, 0, 0)
            dragging = self.drag and self.drag.get("active")
            drag_nid = self.drag["nid"] if dragging else None
            # tab biasa dulu (urut atas→bawah, yang bawah menimpa), lalu kartu, lalu tab yang sedang digeser
            order = [i for i, t in enumerate(tabs) if t[3] <= 0.001] + \
                    sorted((i for i, t in enumerate(tabs) if t[3] > 0.001), key=lambda i: tabs[i][3])
            if drag_nid:
                order = [i for i in order if tabs[i][0]["id"] != drag_nid] + \
                        [i for i in order if tabs[i][0]["id"] == drag_nid]
            for i in order:
                n, y, h, e = tabs[i]
                lifted = n["id"] == drag_nid
                if lifted:   # ikut kursor, sedikit terangkat
                    y = max(2, min(self._H() - h - 2, self.drag["y_now"] - self.drag["off"]))
                elif self._disp_y:
                    y = self._disp_y.get(n["id"], y)
                p = self._tab_p(i)
                if p <= 0:
                    continue
                hov = i == self.hover_idx or lifted
                inner = self._inner(i, e, hov) + (8 if lifted else 0)
                slide = (1 - p) * (inner + 8)
                ins = inner - slide + self._shake(n["id"]) * (1 - e)
                if lifted:
                    for k in range(10, 0, -1):
                        xx, ww = self._span(W, ins + k * 0.4, -14)
                        rrect(cr, xx, y + k * 0.7, ww, h + k * 0.4, 7 + k)
                        cr.set_source_rgba(0, 0, 0, 0.025)
                        cr.fill()
                radius = lerp(7, 12, e)
                x, wd = self._span(W, ins, -14)
                # bayangan: tipis untuk tab, lembut & lebar untuk kartu
                if e > 0.001:
                    for k in range(8, 0, -1):
                        rrect(cr, x - (k * 0.6 if right else 0), y - k * 0.5 + 2, wd + k * 0.6, h + k, radius + k)
                        cr.set_source_rgba(0, 0, 0, 0.018 * e * p)
                        cr.fill()
                for k in (3, 2, 1):
                    rrect(cr, x, y - k, wd, h, radius)
                    cr.set_source_rgba(0, 0, 0, 0.035 * p)
                    cr.fill()
                rrect(cr, x, y, wd, h, radius)
                cr.set_source_rgba(*note_rgb(n["color"]), min(1.0, p * 1.4))
                cr.fill_preserve()
                cr.set_source_rgba(0, 0, 0, 0.10 * p)
                cr.set_line_width(1)
                cr.stroke()

                # garis lipatan + label vertikal: menempel ke sisi dalam bentuk,
                # jadi saat tab tumbuh, keduanya ikut bergeser menjadi pita label kartu
                lx = self._ex(W, ins - 16)
                cr.set_source_rgba(*ink, 0.20 * p)
                cr.set_dash([1.5, 2.5])
                cr.move_to(lx + 0.5, y + 8)
                cr.line_to(lx + 0.5, y + h - 8)
                cr.stroke()
                cr.set_dash([])
                _, layout, lw, lh = self._label_layout(n)
                room = h - 20 - (12 if n["top"] else 0)
                if lw > room:                      # tab dipendekkan: label disingkat "…"
                    layout = self._make_label(tab_label(n["text"]), max(8, room))
                tx = self._ex(W, ins - 8)
                if n["top"]:   # disematkan: ikon pin kecil di ujung atas tab, label turun sedikit
                    cr.save()
                    cr.translate(tx, y + 11)
                    cr.rotate(math.pi / 4)
                    cr.set_source_rgba(*ink, 0.5 * p)
                    cr.rectangle(-1.6, -5, 3.2, 3.6)
                    cr.fill()
                    cr.set_line_width(1.2)
                    cr.move_to(-3.2, -1.4); cr.line_to(3.2, -1.4)
                    cr.move_to(0, -1.4); cr.line_to(0, 4)
                    cr.stroke()
                    cr.restore()
                cr.save()
                cr.translate(tx + lh / 2, y + 12 + (12 if n["top"] else 0))
                cr.rotate(math.pi / 2)
                cr.move_to(0, 0)
                cr.set_source_rgba(*ink, 0.55 * p)
                PangoCairo.show_layout(cr, layout)
                cr.new_path()  # buang titik sisa supaya tidak ada garis nyasar
                cr.restore()
                if n["id"] in self.ctl.floats:
                    cr.arc(tx, y + h - 9, 2, 0, 2 * math.pi)
                    cr.set_source_rgba(*ink, 0.45 * p)
                    cr.fill()
                if n["id"] in self.ring:
                    self._badge(cr, self._ex(W, ins - 4), y + 6, p)

                # isi kartu memudar masuk di paruh kedua animasi
                ta = max(0.0, (e - 0.45) / 0.55) * p
                if ta > 0.01:
                    tl, bl = self._card_text(n)
                    cr.save()
                    rrect(cr, x, y, wd, h, radius)
                    cr.clip()
                    # kanan: teks mulai setelah pita label (ikut bergeser bersama sisi dalam)
                    # kiri : teks mulai dari dekat tepi layar, pita label ada di sisi dalam
                    tx0 = self._ex(W, ins - CARD_BAND - 10) if right else 14
                    cr.set_source_rgba(*((0.93, 0.93, 0.93) if dark else (0.13, 0.13, 0.13)), ta)
                    cr.move_to(tx0, y + 12)
                    PangoCairo.show_layout(cr, tl)
                    cr.new_path()  # buang titik sisa supaya tidak ada garis nyasar
                    _tw, th = tl.get_pixel_size()
                    cr.set_source_rgba(*((0.88, 0.88, 0.88) if dark else (0.18, 0.18, 0.18)), ta)
                    cr.move_to(tx0, y + 16 + th)
                    PangoCairo.show_layout(cr, bl)
                    cr.new_path()  # buang titik sisa supaya tidak ada garis nyasar
                    info = self._card_info(n)
                    if info:
                        il = self._make_label(info, CARD_W - CARD_BAND - 30)
                        cr.set_source_rgba(*ink, 0.5 * ta)
                        cr.move_to(tx0, y + h - 18)
                        PangoCairo.show_layout(cr, il)
                        cr.new_path()
                    cr.restore()

            pp = self._tab_p(len(tabs))
            if pp > 0:
                cr.new_path()
                cx = self._ex(W, pcx)
                r = PLUS_D / 2 * (0.6 + 0.4 * pp)
                hp = self.hover_idx == -2
                cr.arc(cx, pcy, r, 0, 2 * math.pi)
                cr.set_source_rgba(*((0.30, 0.30, 0.33) if dark else (0.97, 0.97, 0.97)), 0.95 * pp)
                cr.fill_preserve()
                cr.set_source_rgba(*ink, (0.35 if hp else 0.16) * pp)
                cr.set_line_width(1)
                cr.stroke()
                a = r * 0.42
                cr.set_source_rgba(*ink, 0.7 * pp)
                cr.set_line_width(1.8)
                cr.set_line_cap(cairo.LINE_CAP_ROUND)
                cr.move_to(cx - a, pcy); cr.line_to(cx + a, pcy)
                cr.move_to(cx, pcy - a); cr.line_to(cx, pcy + a)
                cr.stroke()
            sp = self._tab_p(len(tabs) + 1)
            if sp > 0:
                cr.new_path()
                cx, cy = self._ex(W, pcx), self._set_cy
                r = SET_D / 2 * (0.6 + 0.4 * sp)
                hs = self.hover_idx == -4
                cr.arc(cx, cy, r, 0, 2 * math.pi)
                cr.set_source_rgba(*((0.30, 0.30, 0.33) if dark else (0.97, 0.97, 0.97)), 0.95 * sp)
                cr.fill_preserve()
                cr.set_source_rgba(*ink, (0.35 if hs else 0.16) * sp)
                cr.set_line_width(1)
                cr.stroke()
                # ikon gerigi
                cr.set_source_rgba(*ink, 0.72 * sp)
                ro, ri = r * 0.52, r * 0.34
                cr.set_line_width(r * 0.2)          # gigi tebal & pendek
                cr.set_line_cap(cairo.LINE_CAP_BUTT)
                for k in range(8):
                    ang = k * math.pi / 4 + math.pi / 8
                    cr.move_to(cx + math.cos(ang) * (ri - 0.5), cy + math.sin(ang) * (ri - 0.5))
                    cr.line_to(cx + math.cos(ang) * ro, cy + math.sin(ang) * ro)
                cr.stroke()
                cr.set_line_width(r * 0.16)         # cincin
                cr.arc(cx, cy, ri - r * 0.05, 0, 2 * math.pi)
                cr.stroke()
                cr.new_path()
            fl = self._filter_layout()
            fp = self._tab_p(len(tabs) + 2)
            if fl and fp > 0:
                layout, lw, lh = fl
                cx = self._ex(W, pcx)
                ch = self._filt_h
                y0 = self._filt_cy - ch / 2
                rrect(cr, cx - 11, y0, 22, ch, 11)
                hv = self.hover_idx == -5
                cr.set_source_rgba(*((0.30, 0.30, 0.33) if dark else (0.97, 0.97, 0.97)), 0.95 * fp)
                cr.fill_preserve()
                cr.set_source_rgba(*ink, (0.35 if hv else 0.16) * fp)
                cr.set_line_width(1)
                cr.stroke()
                # corong kecil (tanda filter) lalu nama grup
                cr.set_source_rgba(*ink, 0.6 * fp)
                cr.move_to(cx - 4, y0 + 8); cr.line_to(cx + 4, y0 + 8); cr.line_to(cx + 1, y0 + 12)
                cr.line_to(cx + 1, y0 + 15); cr.line_to(cx - 1, y0 + 16); cr.line_to(cx - 1, y0 + 12)
                cr.close_path()
                cr.fill()
                cr.save()
                cr.translate(cx + lh / 2, y0 + 22)
                cr.rotate(math.pi / 2)
                cr.move_to(0, 0)
                cr.set_source_rgba(*ink, 0.65 * fp)
                PangoCairo.show_layout(cr, layout)
                cr.new_path()
                cr.restore()
            return True

        # ---------- hit test ----------
        def _hit(self, x, y):
            """('rest'|'plus'|'tab'|'card'|None, index, catatan)."""
            d = self._dist(x)
            if self.fan_target < 1 and self.fan < 0.3:
                top, ph, _ = self.rest_geom()
                if d <= REST_MARGIN + REST_W + 6 and top - 4 <= y <= top + ph + 4:
                    return "rest", -3, None
                return None, -1, None
            tabs, (pcx, pcy), _ = self.open_geom()
            for i, (n, ty, h, e) in sorted(enumerate(tabs), key=lambda t: -t[1][3]):
                if e > 0.001 and ty <= y <= ty + h and d <= self._inner(i, e):
                    return "card", i, n
            if abs(y - pcy) <= PLUS_D / 2 + 3 and d <= STRIP_W:
                return "plus", -2, None
            if abs(y - self._set_cy) <= SET_D / 2 + 3 and d <= STRIP_W:
                return "settings", -4, None
            if self._filt_h and self.cfg.get("group_filter") and \
                    abs(y - self._filt_cy) <= self._filt_h / 2 + 2 and d <= STRIP_W:
                return "filter", -5, None
            for i in range(len(tabs) - 1, -1, -1):
                n, ty, h, e = tabs[i]
                if ty <= y <= ty + h and d <= TAB_W + 6:
                    return "tab", i, n
            return None, -1, None

        # ---------- interaksi ----------
        def _enter(self, *_):
            self.pointer_in_strip = True
            self._cancel_check()
            self._expand_window()
            self.open_fan()
            return False

        def _leave(self, *_):
            if self.drag:
                return False
            self.pointer_in_strip = False
            if self.hover_idx != -1:
                self.hover_idx = -1
                self.strip.queue_draw()
            self._cancel_switch()
            self._schedule_check(160)
            return False

        def _motion(self, _w, ev):
            self.pointer_in_strip = True
            self._cancel_check()
            if self.fan_target < 1:
                self.open_fan()
            if self.drag:
                d = self.drag
                d["y_now"] = ev.y
                if not d["active"] and abs(ev.y - d["y"]) > 6 and d["nid"]:
                    d["active"] = True
                    self._cancel_switch()
                    self._snapshot_positions()
                    if d["kind"] == "card":
                        # mulai dari kartu: kartu menyusut jadi tab, tab itu yang digeser
                        d["off"] = min(d["off"], TAB_MIN_H / 2)
                    self.hide_card(keep_strip=True)
                if d["active"]:
                    # posisi tujuan: berapa tab lain yang titik tengahnya di atas kursor
                    others = [t for t in self.open_geom()[0] if t[0]["id"] != d["nid"]]
                    center = ev.y - d["off"] + TAB_MIN_H / 2
                    target = sum(1 for t in others if t[1] + t[2] / 2 < center)
                    ids = [t["id"] for t in store.tabs()]
                    if ids.index(d["nid"]) != target:
                        self._snapshot_positions()
                        if store.move(d["nid"], target):
                            d["moved"] = True
                            self.relayout()
                            self.ctl.refresh_lists()
                    self._start_settle()
                    self.strip.queue_draw()
                return False
            kind, i, n = self._hit(ev.x, ev.y)
            if kind == "card":
                self._cancel_switch()   # di atas kartu yang terbuka: diam
                if self.hover_idx != -1:
                    self.hover_idx = -1
                    self.strip.queue_draw()
                return False
            hi = i if kind in ("tab", "plus", "settings", "filter") else -1
            if hi != self.hover_idx:
                self.hover_idx = hi
                self.strip.queue_draw()
                if kind == "tab" and n["id"] != self.card_id:
                    delay = 70 if self.slot_cur else (0 if self.fan >= 1 else 90)
                    self._schedule_switch(n["id"], delay)
                else:
                    self._cancel_switch()
            if kind is None:
                self._schedule_check(220)
            return False

        def _press(self, _w, ev):
            if ev.type != Gdk.EventType.BUTTON_PRESS:
                return True
            if ev.button == 3:
                self.ctl.popup_menu(ev, self.strip)
                return True
            if ev.button == 1:
                kind, i, n = self._hit(ev.x, ev.y)
                nid = n["id"] if (n and kind in ("tab", "card")) else None
                off = 0.0
                if nid:
                    for t in self.open_geom()[0]:
                        if t[0]["id"] == nid:
                            off = ev.y - t[1]
                self.drag = {"nid": nid, "y": ev.y, "y_now": ev.y, "off": off,
                             "kind": kind, "active": False, "moved": False}
            return True

        def _release(self, _w, ev):
            d, self.drag = self.drag, None
            if ev.button != 1 or d is None:
                return True
            if d["active"]:
                # tab yang dilepas meluncur dari posisi kursor ke tempatnya
                self._disp_y[d["nid"]] = max(2, d["y_now"] - d["off"])
                self._start_settle()
                if d["moved"]:
                    self.ctl.save_now()
                self.strip.queue_draw()
                self._schedule_check(400)
                return True
            kind, _i, n = self._hit(ev.x, ev.y)
            if kind == "plus":
                self.ctl.new_note()
            elif kind == "settings":
                self.hide_card()
                self.ctl.open_settings()
            elif kind == "filter":
                self.ctl.group_filter_menu(ev, self.strip)
            elif kind == "rest":
                self.open_fan()
            elif kind in ("tab", "card"):
                self.ctl.open_editor(n["id"])
            return True

        def _snapshot_positions(self):
            """Catat posisi tampilan sekarang supaya perubahan urutan dianimasikan."""
            for x, y, _h, _e in self.open_geom()[0]:
                self._disp_y.setdefault(x["id"], y)

        def _start_settle(self):
            if not self._settle_id:
                self._settle_id = self.strip.add_tick_callback(self._settle_tick)

        def _settle_tick(self, _w, _clock):
            target = {x["id"]: y for x, y, _h, _e in self.open_geom()[0]}
            done = True
            for nid in list(self._disp_y):
                if nid not in target:
                    self._disp_y.pop(nid)
                    continue
                cur, tgt = self._disp_y[nid], target[nid]
                nxt = cur + (tgt - cur) * 0.28
                if abs(tgt - nxt) < 0.5:
                    nxt = tgt
                else:
                    done = False
                self._disp_y[nid] = nxt
            self.strip.queue_draw()
            if done and not (self.drag and self.drag.get("active")):
                self._disp_y.clear()
                self._settle_id = 0
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE

        def _schedule_switch(self, nid, ms):
            self._cancel_switch()

            def go():
                self._switch_src = 0
                if self.pointer_in_strip and not self.drag:
                    self.show_card(nid)
                    self.unring(nid)   # sudah dilihat
                return False
            if ms <= 0:
                go()
            else:
                self._switch_src = GLib.timeout_add(ms, go)

        def _cancel_switch(self):
            if self._switch_src:
                GLib.source_remove(self._switch_src)
                self._switch_src = 0
            return False

        # ---------- intip / tutup ----------
        def show_card(self, nid):
            n = store.get(nid)
            if n is None or n["archived"]:
                return
            self._cancel_check()
            self._cancel_switch()
            self.open_fan()
            self.card_id = nid
            if self.slot_cur != nid:
                # yang lama menyusut, yang baru tumbuh — di frame yang sama
                prev = self.slot_cur if self.slot_cur is not None else (
                    self.slot_prev if self.slot_t < 1.0 else None)
                if prev == nid:
                    prev = None
                self.slot_prev = prev
                self.slot_cur = nid
                self.slot_anim.set(0.0)
                self.slot_anim.to(1.0, CARD_GROW_MS)
            self.mode = "peek"
            self.strip.queue_draw()

        def hide_card(self, keep_strip=False):
            self._cancel_check()
            self._cancel_switch()
            if self.slot_cur is not None:
                self.slot_prev, self.slot_cur = self.slot_cur, None
                self.slot_anim.set(0.0)
                self.slot_anim.to(1.0, CARD_GROW_MS)
            self.card_id = None
            self.mode = "idle"
            self.hover_idx = -1
            if not (self.pointer_in_strip or keep_strip):
                self.close_fan()
            self.strip.queue_draw()

        def is_peeking(self):
            return self.slot_cur is not None

        def forget(self, nid):
            if self.card_id == nid:
                self.card_id = None
                self.mode = "idle"
            if self.slot_cur == nid:
                self.slot_cur = None
            if self.slot_prev == nid:
                self.slot_prev = None
            self._layout_cache.pop(nid, None)
            self._text_cache.pop(nid, None)
            self.relayout()

        # ---------- pointer ----------
        def _schedule_check(self, ms):
            if self._check_src:
                GLib.source_remove(self._check_src)
            self._check_src = GLib.timeout_add(ms, self._check_pointer)
            return False

        def _cancel_check(self):
            if self._check_src:
                GLib.source_remove(self._check_src)
                self._check_src = 0

        def pointer_inside(self):
            gw = self.get_window()
            if gw is None or not self.get_visible():
                return False
            seat = Gdk.Display.get_default().get_default_seat()
            res = gw.get_device_position(seat.get_pointer())
            kind, _i, _n = self._hit(res[1], res[2])
            return kind is not None

        def _check_pointer(self):
            self._check_src = 0
            if self.ctl.suppress or self.drag:
                return False
            if self.pointer_inside():
                return False
            self.pointer_in_strip = False
            if self.hover_idx != -1:
                self.hover_idx = -1
                self.strip.queue_draw()
            if self.slot_cur is not None:
                self.hide_card()
            else:
                self.close_fan()
            self.update_shape(force=True)
            return False

        # ---------- input shape: hanya area yang terlihat menerima klik ----------
        def update_shape(self, force=False):
            if self.get_window() is None:
                return
            W = self._W()
            rects = []
            if self.fan_target > 0 or self.fan > 0:
                tabs, _, (top, bottom) = self.open_geom()
                t = min(top, self.rest_geom()[0])
                x, wd = self._span(W, STRIP_W, 0)
                rects.append((int(x), int(t - 4), int(wd), int(bottom - t + 8)))
                for i, (n, y, h, e) in enumerate(tabs):
                    if e > 0.001:
                        x, wd = self._span(W, self._inner(i, e) + 4, 0)
                        rects.append((int(x), int(y - 2), int(math.ceil(wd)), int(math.ceil(h + 4))))
            else:
                top, ph, _ = self.rest_geom()
                x, wd = self._span(W, REST_MARGIN + REST_W + 6, 0)
                rects.append((int(x), int(top - 4), int(wd), int(ph + 8)))
            if rects == self.regions and not force:
                return
            self.regions = rects
            self.input_shape_combine_region(region_from(rects))
            if not self.composited:
                self.shape_combine_region(region_from(rects))

        def place(self):
            mon = primary_monitor()
            geo, wa = mon.get_geometry(), mon.get_workarea()
            self._win_w = (STRIP_W + 2) if self.compact else (CARD_W + SH + 6)
            self._win_h = self._needed_h()
            self.set_size_request(self._win_w, self._win_h)
            self.resize(self._win_w, self._win_h)
            x = geo.x + geo.width - self._win_w if self._right() else geo.x
            y = wa.y + (wa.height - self._win_h) // 2
            self._target_pos = (x, y)
            self._fix_moves = 0
            self.move(x, y)
            # area klik dipasang ulang setelah ukuran berubah (jangan pernah basi)
            GLib.idle_add(lambda: (self.update_shape(force=True), False)[1])

        def _on_configure(self, _w, ev):
            tp = getattr(self, "_target_pos", None)
            if tp and (abs(ev.x - tp[0]) > 1 or abs(ev.y - tp[1]) > 1) and self._fix_moves < 3:
                self._fix_moves += 1
                GLib.idle_add(lambda: (self.move(*tp), False)[1])
            return False

        def apply_side(self):
            self.invalidate_labels()
            self.place()


def checklist_progress(text):
    """(selesai, total) untuk baris ☐/☑."""
    done = total = 0
    for line in (text or "").splitlines():
        t = line.lstrip()
        if t.startswith("☑"):
            done += 1
            total += 1
        elif t.startswith("☐"):
            total += 1
    return done, total


def fmt_reminder(ts, now=None):
    now = now if now is not None else time.time()
    lt, ln = time.localtime(ts), time.localtime(now)
    hm = time.strftime("%H:%M", lt)
    if lt.tm_yday == ln.tm_yday and lt.tm_year == ln.tm_year:
        return hm
    tomorrow = time.localtime(now + 86400)
    if lt.tm_yday == tomorrow.tm_yday and lt.tm_year == tomorrow.tm_year:
        return tr("besok ") + hm
    return f"{lt.tm_mday} {month_name(lt.tm_mon - 1)} {hm}"



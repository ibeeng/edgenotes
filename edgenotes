            menu = Gtk.Menu()
            prev = None
            cur = store.font_of(n)
            for fid, (name, _) in FONTS.items():
                name = tr(name)
                mi = Gtk.RadioMenuItem.new_with_label_from_widget(prev, name)
                prev = mi
                mi.set_active(fid == cur)
                mi.connect("toggled", lambda m, f=fid: m.get_active() and self.ctl.set_font(self.nid, f))
                menu.append(mi)
            menu.append(Gtk.SeparatorMenuItem())
            mi = Gtk.MenuItem(label=tr("Jadikan font default"))
            mi.connect("activate", lambda *_: self.ctl.set_default_font(store.font_of(store.get(self.nid))))
            menu.append(mi)
            menu.show_all()
            menu.connect("deactivate", lambda m: GLib.idle_add(lambda: (m.destroy(), False)[1]))
            menu.attach_to_widget(self, None)
            menu.popup_at_pointer(None)

        def close_note(self):
            if self.closing:
                return
            self.closing = True
            self._fade.to(0.0, 120)
            GLib.timeout_add(130, lambda: (self.ctl.close_editor(self.nid), False)[1])

        def _key(self, _w, ev):
            ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
            key = (Gdk.keyval_name(ev.keyval) or "").lower()
            if key == "escape" or (ctrl and key == "w"):
                self.close_note()
                return True
            if ctrl and key == "n":
                self.ctl.new_note()
                return True
            if ctrl and key == "f":
                self.ctl.open_search()
                return True
            return False


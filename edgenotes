    # ================================================================ fullscreen watcher
    class FullscreenWatcher:
        """Event-driven (tanpa polling): sembunyikan strip saat ada app layar penuh."""

        def __init__(self, on_change):
            self.on_change = on_change
            self.win = None
            self.hid = 0
            x11 = "X11" in type(Gdk.Display.get_default()).__name__
            self.scr = Wnck.Screen.get_default() if (Wnck and x11) else None
            if not self.scr:
                return
            self.scr.force_update()
            self.scr.connect("active-window-changed", self._active_changed)
            self._active_changed(self.scr, None)

        def _active_changed(self, scr, _prev):
            if self.win is not None and self.hid:
                try:
                    self.win.disconnect(self.hid)
                except Exception:
                    pass
            self.win = scr.get_active_window()
            self.hid = self.win.connect("state-changed", lambda *_: self._eval()) if self.win else 0
            self._eval()

        def _eval(self):
            w = self.win
            fs = False
            info = None
            if w is not None:
                try:
                    g = primary_monitor().get_geometry()
                    info = dict(
                        name=w.get_name(), fullscreen=w.is_fullscreen(),
                        normal=w.get_window_type() == Wnck.WindowType.NORMAL,
                        skip=w.is_skip_tasklist(), pid=w.get_pid(),
                        geom=tuple(w.get_geometry()), mon=(g.x, g.y, g.width, g.height))
                    fs = fullscreen_blocks(info["fullscreen"], info["normal"], info["skip"],
                                           info["pid"], os.getpid(), info["geom"], info["mon"])
                except Exception as e:
                    info, fs = {"error": repr(e)}, False
            if DEBUG:
                sys.stderr.write(f"[edgenotes] jendela aktif: {info} -> sembunyi={fs}\n")
            self.on_change(fs)

    # ================================================================ theme
    class Theme:
        def __init__(self, on_change):
            self.on_change = on_change
            self.iface = None
            self.keys = []
            src = Gio.SettingsSchemaSource.get_default()
            if src and src.lookup("org.gnome.desktop.interface", True):
                self.iface = Gio.Settings.new("org.gnome.desktop.interface")
                self.keys = list(self.iface.props.settings_schema.list_keys())
                for k in ("color-scheme", "gtk-theme"):
                    if k in self.keys:
                        self.iface.connect("changed::" + k, lambda *_: self.refresh())
            Gtk.Settings.get_default().connect("notify::gtk-theme-name", lambda *_: self.refresh())

        def detect(self):
            mode = store.config["theme"]
            if mode in ("light", "dark"):
                return mode == "dark"
            if self.iface is not None:
                if "color-scheme" in self.keys and self.iface.get_string("color-scheme") == "prefer-dark":
                    return True
                if "gtk-theme" in self.keys and "dark" in self.iface.get_string("gtk-theme").lower():
                    return True
            name = Gtk.Settings.get_default().props.gtk_theme_name or ""
            return "dark" in name.lower()

        def refresh(self, force=False):
            d = self.detect()
            if d != TH["dark"] or force:
                TH["dark"] = d
                self.on_change()

    # ================================================================ application
    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID,
                             flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
            self.edge = None
            self.floats = {}
            self.all_win = None
            self.settings_win = None
            self.hub = None
            self.toast = None
            self.suppress = 0
            self._save_src = 0
            self.fs_hidden = False
            self.quitting = False
            self.focus_until = 0
            self._focus_src = 0
            self._rem_src = 0
            self.search_win = None
            self.support_win = None
            self.history_wins = {}

        def strip_hidden(self):
            return self.fs_hidden or self.quitting or bool(self.focus_until)

        def do_startup(self):
            Gtk.Application.do_startup(self)
            self.hold()  # tetap hidup walau semua jendela lain ditutup; keluar hanya lewat "Keluar"
            act = Gio.SimpleAction.new("open-note", GLib.VariantType.new("s"))
            act.connect("activate", lambda _a, v: self.open_editor(v.get_string()))
            self.add_action(act)
            self.css = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.theme = Theme(self.apply_theme)
            self.theme.refresh(force=True)

        # ---------- tema ----------
        def apply_theme(self):
            dark = TH["dark"]
            Gtk.Settings.get_default().props.gtk_application_prefer_dark_theme = dark
            self.css.load_from_data(build_css(store.config, dark))
            if self.edge:
                self.edge.invalidate_labels()
                self.edge.refresh_card()
                self.edge.queue_draw()
            for w in self.floats.values():
                w.refresh()
                w.queue_draw()
            if self.hub:
                self.hub.queue_draw()

        # ---------- command line ----------
        def do_command_line(self, cmdline):
            args = cmdline.get_arguments()[1:]
            first = self.edge is None
            if first:
                if "--quit" in args:
                    return 0
                self.edge = EdgeWindow(self)
                self.add_window(self.edge)
                self.edge.show_all()
                self.edge.place()
                self.fs = FullscreenWatcher(self._fullscreen_changed)
                self._arm_reminders()
            e = self.edge
            if self.fs_hidden and any(a in args for a in ("--show", "--toggle", "--all", "--new")):
                self._fullscreen_changed(False, force=True)
            if self.focus_until and any(a in args for a in ("--show", "--toggle", "--new")):
                self.end_focus()
            if "--quit" in args:
                self.quit()
            elif "--search" in args:
                self.open_search()
            elif "--focus" in args:
                i = args.index("--focus")
                mins = int(args[i + 1]) if i + 1 < len(args) and args[i + 1].isdigit() else 60
                if self.focus_until:
                    self.end_focus()
                else:
                    self.start_focus(mins)
            elif "--support" in args:
                self.open_support()
            elif "--new" in args:
                self.new_note()
            elif "--all" in args:
                self.open_all()
            elif "--settings" in args:
                self.open_settings()
            elif "--archive" in args:
                self.archive_current()
            elif "--toggle" in args:
                self.toggle()
            elif "--show" in args:
                if not self.floats:
                    self.toggle()
            elif "--hide" in args:
                e.hide_card()
                for nid in list(self.floats):
                    self.close_editor(nid)
            elif not first:
                self.open_all()
            return 0

        def quit(self):
            self.quitting = True
            log("keluar")
            Gtk.Application.quit(self)

        def do_shutdown(self):
            for nid, w in list(self.floats.items()):
                store.update(nid, float=list(w.geom))  # hanya posisi; tidak dibuka ulang otomatis
            self.save_now()
            Gtk.Application.do_shutdown(self)

        # ---------- simpan ----------
        def schedule_save(self):
            if self._save_src:
                GLib.source_remove(self._save_src)
            self._save_src = GLib.timeout_add(SAVE_DELAY, self.save_now)

        def save_now(self):
            if self._save_src:
                GLib.source_remove(self._save_src)
                self._save_src = 0
            store.save()
            for w in self.floats.values():
                w.set_saved(True)
            return False

        def refresh_lists(self):
            if self.all_win:
                self.all_win.refresh()

        # ---------- perubahan catatan ----------
        def note_changed(self, nid, label_changed):
            if label_changed:
                self.edge.invalidate_labels()
            if self.edge.card_id == nid:
                self.edge.refresh_card()
            w = self.floats.get(nid)
            if w:
                w.set_saved(False)
                w.refresh_progress()
            self.schedule_save()

        def _restyle(self, nid):
            if self.edge.card_id == nid:
                self.edge.refresh_card()
            w = self.floats.get(nid)
            if w:
                w.refresh()
            self.edge.strip.queue_draw()
            self.refresh_lists()

        def set_color(self, nid, color):
            store.update(nid, color=color)
            self.save_now()
            self._restyle(nid)

        def set_font(self, nid, font):
            store.update(nid, font=font)
            self.save_now()
            self._restyle(nid)

        def set_default_font(self, font):
            store.config["font"] = font
            store.save_config()
            self.save_now()
            for nid in list(self.floats):
                self._restyle(nid)
            if self.edge.card_id:
                self._restyle(self.edge.card_id)
            self._show_toast(tr("Font default: {f}").format(f=tr(FONTS[font][0])), None)

        def new_note(self, floating=False, text=""):
            n = store.new_note(text=text)  # paling atas; font None = ikut font default
            if store.config.get("group_filter"):
                n["group"] = store.config["group_filter"]   # ikut grup yang sedang ditampilkan
            self.save_now()
            self.edge.hide_card()
            self.edge.relayout()
            self.refresh_lists()
            self.open_editor(n["id"], focus_title=True)

        def discard_note(self, nid):
            """Buang catatan kosong tanpa toast."""
            store.delete(nid)
            self.save_now()
            self.edge.forget(nid)
            self.refresh_lists()

        def delete_note(self, nid):
            n = store.get(nid)
            if not n:
                return
            self._close_float(nid, keep_geom=False)
            self.edge.forget(nid)
            snapshot = store.delete(nid)
            self.save_now()
            self.refresh_lists()
            if not snapshot["text"].strip():
                return

            def undo():
                store.restore(snapshot)
                self.save_now()
                self.edge.relayout()
                self.refresh_lists()
            self._show_toast(tr("“{t}” dihapus").format(t=note_title(snapshot["text"])[:28]), undo)

        def archive_note(self, nid, archived=True):
            n = store.get(nid)
            if not n:
                return
            prev_float = n["float"]
            prev_order = n["order"]
            if archived:
                self._close_float(nid, keep_geom=False)
                self.edge.forget(nid)
            if store.set_archived(nid, archived) is None:
                return
            self.save_now()
            self.edge.relayout()
            self.refresh_lists()
            w = self.floats.get(nid)
            if w:
                w.refresh()
            title = note_title(n["text"])[:28]
            if archived:
                def undo():
                    store.set_archived(nid, False)
                    nn = store.get(nid)
                    if nn:
                        nn["order"] = prev_order
                        nn["float"] = prev_float
                    self.save_now()
                    self.edge.relayout()
                    self.refresh_lists()
                self._show_toast(tr("“{t}” diarsipkan").format(t=title), undo)
            else:
                self._show_toast(tr("“{t}” dikeluarkan dari arsip").format(t=title), None)

        def archive_current(self):
            nid = None
            for fid, w in self.floats.items():
                if w.is_active():
                    nid = fid
            if nid is None and len(self.floats) == 1:
                nid = next(iter(self.floats))
            if nid is None and self.edge.is_peeking():
                nid = self.edge.card_id
            if nid is None:
                n = store.latest()
                nid = n["id"] if n else None
            if nid:
                self.archive_note(nid, True)

        def toggle(self):
            for nid, w in list(self.floats.items()):
                if w.is_active():
                    w.close_note()
                    return
            n = store.latest()
            if not n:
                self.new_note()
            else:
                self.open_editor(n["id"])

        # ---------- jendela editor ----------
        def open_editor(self, nid, focus_title=False):
            n = store.get(nid)
            if not n:
                return
            self.edge.unring(nid)
            self.edge.hide_card()
            w = self.floats.get(nid)
            if w is None:
                w = NoteWindow(self, nid, focus_title=focus_title)
                self.floats[nid] = w
                self.add_window(w)
                w.show_all()
                self.edge.relayout()
                self.refresh_lists()
            w.present()

        popout = open_editor  # nama lama

        def _close_float(self, nid, keep_geom=True):
            w = self.floats.pop(nid, None)
            if w is not None:
                if keep_geom:
                    store.update(nid, float=list(w.geom))  # posisi diingat untuk dibuka lagi
                w.destroy()  # dihancurkan, bukan disembunyikan

        def close_editor(self, nid):
            if nid not in self.floats:
                return
            self._close_float(nid, keep_geom=True)
            n = store.get(nid)
            if n is not None and not n["text"].strip():
                self.discard_note(nid)
                return
            self.save_now()
            self.edge.relayout()
            self.refresh_lists()

        dock = close_editor  # nama lama

        # ---------- sematkan, grup, gambar, riwayat ----------
        def set_top(self, nid, on):
            store.update(nid, top=bool(on))
            self.save_now()
            self.edge.invalidate_labels()
            self.refresh_lists()
            self._show_toast(tr("Disematkan di atas strip") if on else tr("Tidak disematkan lagi"), None)

        def set_group(self, nid, group):
            store.update(nid, group=(group or "").strip()[:40])
            self.save_now()
            self.edge.forget(nid) if (store.config["group_filter"] and group != store.config["group_filter"]) \
                else self.edge.relayout()
            self.edge.refresh_card()
            self.refresh_lists()
            self._show_toast(tr("Masuk grup “{g}”").format(g=group) if group else tr("Dikeluarkan dari grup"), None)

        def set_group_filter(self, group):
            store.config["group_filter"] = group or ""
            store.save_config()
            self.edge.hide_card()
            self.edge.invalidate_labels()
            self.edge.place()
            self._show_toast(tr("Strip menampilkan grup “{g}”").format(g=group) if group else
                             tr("Strip menampilkan semua catatan"), None)

        def group_filter_menu(self, ev, widget):
            menu = Gtk.Menu()
            self._fill_group_menu(menu)
            self._popup_from_strip(menu, ev, widget)

        def _fill_group_menu(self, menu):
            prev = None
            cur = store.config.get("group_filter") or ""
            for g in [""] + store.groups():
                mi = Gtk.RadioMenuItem.new_with_label_from_widget(prev, g or tr("Semua catatan"))
                prev = mi
                mi.set_active(g == cur)
                mi.connect("toggled", lambda m, gg=g: m.get_active() and self.set_group_filter(gg))
                menu.append(mi)
            if not store.groups():
                mi = Gtk.MenuItem(label=tr("Belum ada grup (atur lewat ⋯ di jendela catatan)"))
                mi.set_sensitive(False)
                menu.append(mi)

        def _popup_from_strip(self, menu, ev, widget):
            menu.show_all()
            self.suppress += 1

            def done(m):
                self.suppress = max(0, self.suppress - 1)
                self.edge._schedule_check(300)
                GLib.idle_add(lambda: (m.destroy(), False)[1])
            menu.connect("deactivate", done)
            menu.attach_to_widget(widget, None)
            menu.popup_at_pointer(ev)

        def add_image(self, nid, pixbuf):
            try:
                ok, buf = pixbuf.save_to_bufferv("png", [], [])
            except GLib.Error as e:
                self._show_toast(tr("Gambar gagal disimpan: {e}").format(e=e.message), None)
                return
            if not ok or not store.add_image_bytes(nid, bytes(buf)):
                return
            self.save_now()
            self._restyle(nid)

        def remove_image(self, nid, name):
            if not store.remove_image(nid, name):
                return
            self.save_now()
            self._restyle(nid)

            def undo():
                n = store.get(nid)
                if n is not None and name not in n["images"]:
                    n["images"].append(name)
                    self.save_now()
                    self._restyle(nid)
            self._show_toast(tr("Gambar dihapus"), undo)

        def open_history(self, nid):
            w = self.history_wins.get(nid)
            if w is None:
                w = HistoryWindow(self, nid, self.floats.get(nid))
                self.history_wins[nid] = w
                w.connect("destroy", lambda *_: self.history_wins.pop(nid, None))
                w.show_all()
            w.present()

        def restore_version(self, nid, idx):
            if store.restore_version(nid, idx) is None:
                return
            self.save_now()
            w = self.floats.get(nid)
            if w:
                w.editor.bind(nid)
                w.refresh()
            self.edge.invalidate_labels()
            self.edge.refresh_card()
            self.refresh_lists()
            self._show_toast(tr("Versi lama dipulihkan (isi sebelumnya masuk riwayat)"), None)

        # ---------- pengingat ----------
        def set_reminder(self, nid, ts):
            store.update(nid, reminder=ts)
            self.save_now()
            if ts is None:
                self.edge.unring(nid)
            self._arm_reminders()
            self._restyle(nid)
            self._show_toast(tr("Diingatkan {when}").format(when=fmt_reminder(ts)) if ts else tr("Pengingat dihapus"), None)

        def _arm_reminders(self):
            """Satu timer saja, ke pengingat terdekat (tidak ada polling)."""
            if self._rem_src:
                GLib.source_remove(self._rem_src)
                self._rem_src = 0
            nxt = store.next_reminder()
            if nxt is None:
                return
            # dibatasi 1 jam supaya tetap tepat walau laptop sempat tidur
            delay = max(0.0, min(nxt - time.time(), 3600.0))
            self._rem_src = GLib.timeout_add(int(delay * 1000) + 300, self._fire_reminders)

        def _fire_reminders(self):
            self._rem_src = 0
            due = store.due_reminders()
            for n in due:
                n["reminded"] = True
                self._notify(n)
            if due:
                self.save_now()
            self._arm_reminders()
            return False

        def _notify(self, n):
            title = note_title(n["text"])
            log(f"pengingat: {title}")
            try:
                notif = Gio.Notification.new("⏰ " + title)
                notif.set_body(note_snippet(n["text"]) or tr("Klik untuk membuka catatan."))
                notif.set_priority(Gio.NotificationPriority.HIGH)
                notif.set_default_action_and_target_value("app.open-note", GLib.Variant("s", n["id"]))
                self.send_notification("reminder-" + n["id"], notif)
            except Exception as e:  # tanpa daemon notifikasi: cukup toast + tab bergoyang
                log(f"notifikasi gagal: {e}")
            self.edge.ring_note(n["id"])
            self._restyle(n["id"])
            nid = n["id"]
            self._show_toast(f"⏰ {title[:40]}", lambda: self.open_editor(nid), tr("Buka"))

        # ---------- cari cepat ----------
        def open_search(self):
            if self.search_win is None:
                self.search_win = SearchWindow(self)
                self.add_window(self.search_win)
                self.search_win.connect("destroy", lambda *_: setattr(self, "search_win", None))
                wa = primary_monitor().get_workarea()
                self.search_win.move(wa.x + (wa.width - 520) // 2, wa.y + wa.height // 5)
                self.search_win.show_all()
            self.search_win.present_with_time(Gtk.get_current_event_time())
            self.search_win.entry.grab_focus()

        # ---------- mode fokus ----------
        def start_focus(self, minutes):
            minutes = max(1, int(minutes))
            self.focus_until = time.time() + minutes * 60
            if self._focus_src:
                GLib.source_remove(self._focus_src)
            self._focus_src = GLib.timeout_add_seconds(minutes * 60, self._focus_over)
            self.edge.hide_card()
            self.edge.hide()
            until = time.strftime("%H:%M", time.localtime(self.focus_until))
            self._show_toast(tr("Mode fokus sampai {t}").format(t=until), self.end_focus, tr("Batalkan"))

        def _focus_over(self):
            self._focus_src = 0
            self.end_focus()
            return False

        def end_focus(self):
            if self._focus_src:
                GLib.source_remove(self._focus_src)
                self._focus_src = 0
            if not self.focus_until:
                return
            self.focus_until = 0
            if not self.fs_hidden:
                self.edge.show()
                self.edge.place()

        # ---------- dukungan ----------
        def open_support(self):
            if self.support_win is None:
                self.support_win = SupportWindow(self)
                self.add_window(self.support_win)
                self.support_win.connect("destroy", lambda *_: setattr(self, "support_win", None))
                self.support_win.show_all()
            self.support_win.present()

        # ---------- jendela semua catatan ----------
        def open_hub(self, tab=None):
            if self.hub is None:
                self.hub = HubWindow(self)
                self.add_window(self.hub)
                self.hub.connect("destroy", self._hub_closed)
                self.hub.show_all()
                self.all_win = self.hub.notes
                self.settings_win = self.hub
            self.hub.show_tab(tab or store.config.get("hub_tab") or "notes")
            self.hub.present()

        def open_all(self):
            self.open_hub("notes")

        def _hub_closed(self, *_):
            self.hub = None
            self.all_win = None
            self.settings_win = None

        _all_closed = _settings_closed = _hub_closed

        # ---------- pengaturan ----------
        def open_settings(self):
            # tombol ⚙: jendela yang sama, buka tab terakhir (default: Catatan)
            self.open_hub()

        def set_language(self, code):
            store.config["lang"] = code
            store.save_config()
            set_lang(code)
            self._show_toast(tr("Bahasa diganti. Mulai ulang EdgeNotes supaya semua bagian ikut berubah."),
                             self.restart, tr("Mulai ulang"))

        def restart(self):
            self.save_now()
            log("mulai ulang")
            os.execv(sys.executable, [sys.executable, os.path.abspath(sys.argv[0])])

        def set_font_size(self, size):
            store.config["font_size"] = int(size)
            store.save_config()
            self.apply_theme()

        # ---------- toast ----------
        def _show_toast(self, message, undo, action=tr("Urungkan")):
            if self.toast is not None:
                self.toast.close_now()
            self.toast = Toast(self, message, undo, action)

        # ---------- layar penuh ----------
        def _fullscreen_changed(self, fs, force=False):
            hide = fs and store.config["hide_fullscreen"] and not force
            if hide and not self.fs_hidden:
                self.fs_hidden = True
                self.edge.hide_card()
                self.edge.hide()
            elif not hide and self.fs_hidden:
                self.fs_hidden = False
                if not self.focus_until:
                    self.edge.show()
                    self.edge.place()

        # ---------- menu klik kanan ----------
        def popup_menu(self, ev, widget):
            cfg = store.config
            menu = Gtk.Menu()

            def item(label, cb):
                mi = Gtk.MenuItem(label=label)
                mi.connect("activate", lambda *_: cb())
                menu.append(mi)
                return mi

            def check(parent, label, active, cb):
                mi = Gtk.CheckMenuItem(label=label)
                mi.set_active(active)
                mi.connect("toggled", lambda m: cb(m.get_active()))
                parent.append(mi)

            def radios(label, options, current, cb):
                sub = Gtk.Menu()
                prev = None
                for key, name in options:
                    mi = Gtk.RadioMenuItem.new_with_label_from_widget(prev, name)
                    prev = mi
                    mi.set_active(key == current)
                    mi.connect("toggled", lambda m, k=key: m.get_active() and cb(k))
                    sub.append(mi)
                top = Gtk.MenuItem(label=label)
                top.set_submenu(sub)
                menu.append(top)

            item(tr("Catatan baru"), self.new_note)
            item(tr("Cari…"), self.open_search)
            item(tr("Semua catatan…"), self.open_all)
            gsub = Gtk.Menu()
            self._fill_group_menu(gsub)
            gtop = Gtk.MenuItem(label=tr("Tampilkan grup"))
            gtop.set_submenu(gsub)
            menu.append(gtop)
            fsub = Gtk.Menu()
            for label, mins in ((tr("30 menit"), 30), (tr("1 jam"), 60), (tr("2 jam"), 120)):
                mi = Gtk.MenuItem(label=label)
                mi.connect("activate", lambda _m, mm=mins: self.start_focus(mm))
                fsub.append(mi)
            ftop = Gtk.MenuItem(label=tr("Mode fokus (sembunyikan strip)"))
            ftop.set_submenu(fsub)
            menu.append(ftop)
            item(tr("Pengaturan…"), self.open_settings)
            if support_image() or DONATE_URL:
                item(tr("Dukung pengembang ♥"), self.open_support)
            menu.append(Gtk.SeparatorMenuItem())
            other = "left" if cfg["side"] == "right" else "right"
            item(tr("Pindah ke kiri") if other == "left" else tr("Pindah ke kanan"), lambda: self.set_side(other))
            radios(tr("Tema"), (("auto", tr("Ikuti sistem")), ("light", tr("Terang")), ("dark", tr("Gelap"))),
                   cfg["theme"], self.set_theme)
            radios(tr("Font default"), [(k, tr(v[0])) for k, v in FONTS.items()], cfg["font"],
                   self.set_default_font)
            check(menu, tr("Sembunyikan saat layar penuh") + ("" if Wnck else tr(" (perlu libwnck)")),
                  cfg["hide_fullscreen"], self.set_hide_fullscreen)
            check(menu, tr("Jalankan saat login"), autostart_enabled(), self.set_autostart)
            item(tr("Pasang shortcut global"), self.install_shortcuts)
            menu.append(Gtk.SeparatorMenuItem())
            item(tr("Impor catatan…"), lambda: self.import_dialog(None))
            item(tr("Ekspor cadangan (JSON)…"), lambda: self.export_json_dialog(None))
            item(tr("Ekspor Markdown…"), lambda: self.export_md_dialog(None))
            item(tr("Buka folder data"), lambda: Gio.AppInfo.launch_default_for_uri(
                GLib.filename_to_uri(store.dir, None), None))
            menu.append(Gtk.SeparatorMenuItem())
            item(tr("Keluar"), self.quit)
            menu.show_all()
            self.suppress += 1

            def done(m):
                self.suppress = max(0, self.suppress - 1)
                self.edge._schedule_check(300)
                GLib.idle_add(lambda: (m.destroy(), False)[1])  # lepas dari memori
            menu.connect("deactivate", done)
            menu.attach_to_widget(widget, None)
            menu.popup_at_pointer(ev)

        def set_side(self, side):
            self.edge.hide_card()
            store.config["side"] = side
            store.save_config()
            self.edge.apply_side()
            self.edge.strip.queue_draw()

        def set_theme(self, mode):
            store.config["theme"] = mode
            store.save_config()
            self.theme.refresh(force=True)

        def set_hide_fullscreen(self, on):
            store.config["hide_fullscreen"] = on
            store.save_config()
            if self.fs_hidden and not on:
                self._fullscreen_changed(False)

        def set_autostart(self, on):
            try:
                set_autostart(on)
                self._show_toast(tr("Akan jalan otomatis saat login") if on else
                                 tr("Tidak lagi jalan saat login"), None)
            except OSError as e:
                self._show_toast(tr("Gagal: {e}").format(e=e), None)

        def install_shortcuts(self):
            ok, msg = gnome_shortcuts(True)
            dlg = Gtk.MessageDialog(transient_for=None, modal=True,
                                    message_type=Gtk.MessageType.INFO if ok else Gtk.MessageType.WARNING,
                                    buttons=Gtk.ButtonsType.OK, text=tr("Shortcut global"))
            dlg.format_secondary_text(msg)
            self.suppress += 1
            dlg.run()
            dlg.destroy()
            self.suppress = max(0, self.suppress - 1)

        # ---------- impor / ekspor ----------
        def _chooser(self, parent, title, action, accept):
            dlg = Gtk.FileChooserNative.new(title, parent, action, accept, tr("_Batal"))
            return dlg

        def _run(self, dlg):
            self.suppress += 1
            try:
                return dlg.run()
            finally:
                self.suppress = max(0, self.suppress - 1)

        def export_json_dialog(self, parent):
            dlg = self._chooser(parent, tr("Ekspor cadangan"), Gtk.FileChooserAction.SAVE, tr("_Simpan"))
            dlg.set_do_overwrite_confirmation(True)
            dlg.set_current_name(time.strftime("edgenotes-backup-%Y-%m-%d.json"))
            dlg.set_current_folder(os.path.expanduser("~"))
            if self._run(dlg) == Gtk.ResponseType.ACCEPT:
                Store._write_json(dlg.get_filename(), store.export_json())
                self._show_toast(tr("Cadangan tersimpan"), None)
            dlg.destroy()

        def export_md_dialog(self, parent):
            dlg = self._chooser(parent, tr("Ekspor Markdown"), Gtk.FileChooserAction.SAVE, tr("_Simpan"))
            dlg.set_do_overwrite_confirmation(True)
            dlg.set_current_name(time.strftime("edgenotes-%Y-%m-%d.md"))
            dlg.set_current_folder(os.path.expanduser("~"))
            if self._run(dlg) == Gtk.ResponseType.ACCEPT:
                with open(dlg.get_filename(), "w", encoding="utf-8") as f:
                    f.write(store.export_markdown())
                self._show_toast(tr("Markdown tersimpan"), None)
            dlg.destroy()

        def import_dialog(self, parent):
            dlg = self._chooser(parent, tr("Impor catatan"), Gtk.FileChooserAction.OPEN, tr("_Impor"))
            dlg.set_select_multiple(True)
            f = Gtk.FileFilter()
            f.set_name(tr("Cadangan EdgeNotes, Markdown, teks"))
            for p in ("*.json", "*.md", "*.txt"):
                f.add_pattern(p)
            dlg.add_filter(f)
            if self._run(dlg) == Gtk.ResponseType.ACCEPT:
                count, errors = 0, 0
                for path in dlg.get_filenames():
                    try:
                        with open(path, "r", encoding="utf-8") as fh:
                            content = fh.read()
                        if path.lower().endswith(".json"):
                            count += store.import_json(json.loads(content))
                        elif store.import_text(content):
                            count += 1
                    except (OSError, ValueError, UnicodeDecodeError):
                        errors += 1
                self.save_now()
                self.edge.relayout()
                self.refresh_lists()
                msg = tr("{n} catatan diimpor").format(n=count)
                if errors:
                    msg += tr(" · {n} file gagal").format(n=errors)
                self._show_toast(msg, None)
            dlg.destroy()

    return App().run(argv)


LOG_PATH = None


def log(msg):
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n"
    if DEBUG:
        sys.stderr.write("[edgenotes] " + line)
    if LOG_PATH:
        try:
            with open(LOG_PATH, "a", encoding="utf-8") as f:
                f.write(line)
        except OSError:
            pass


def setup_logging():
    """Log kejadian penting + crash ke ~/.local/share/edgenotes/edgenotes.log."""
    global LOG_PATH
    import faulthandler
    import signal
    import traceback
    os.makedirs(data_dir(), exist_ok=True)
    LOG_PATH = os.path.join(data_dir(), "edgenotes.log")
    try:
        if os.path.getsize(LOG_PATH) > 256 * 1024:
            os.replace(LOG_PATH, LOG_PATH + ".old")
    except OSError:
        pass
    try:
        signal.signal(signal.SIGHUP, signal.SIG_IGN)  # tidak ikut mati saat terminal ditutup
    except (AttributeError, ValueError):
        pass
    try:
        faulthandler.enable(open(LOG_PATH, "a"))  # crash level C (segfault) ikut tercatat
    except OSError:
        pass

    def hook(t, v, tb):
        log("ERROR: " + "".join(traceback.format_exception(t, v, tb)).rstrip())
        sys.__excepthook__(t, v, tb)
    sys.excepthook = hook
    log(f"mulai EdgeNotes {VERSION} (pid {os.getpid()})")


def main(argv=None):
    argv = list(sys.argv if argv is None else argv)
    args = argv[1:]
    if any(a in ("-h", "--help") for a in args):
        print(__doc__.strip())
        return 0
    if "--version" in args:
        print(f"EdgeNotes {VERSION}")
        return 0
    try:  # bahasa juga dipakai pesan di terminal
        with open(os.path.join(data_dir(), "config.json"), encoding="utf-8") as f:
            set_lang(json.load(f).get("lang", "en"))
    except (OSError, ValueError, AttributeError):
        pass
    if "--install-shortcuts" in args or "--remove-shortcuts" in args:
        ok, msg = gnome_shortcuts("--install-shortcuts" in args)
        print(msg)
        return 0 if ok else 1
    if "--autostart" in args:
        i = args.index("--autostart")
        val = args[i + 1] if i + 1 < len(args) else "on"
        set_autostart(val != "off")
        print(tr("Autostart aktif") if val != "off" else tr("Autostart nonaktif"))
        return 0
    setup_logging()
    return run_gui(argv)


if __name__ == "__main__":
    sys.exit(main())

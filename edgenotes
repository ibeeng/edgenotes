        def refresh(self):
            n = store.get(self.nid)
            if not n:
                return
            self.editor.refresh()
            self.dots.selected = n["color"]
            self.dots.queue_draw()
            self.btn_done.set_label(tr("Aktifkan lagi") if n["archived"] else tr("Selesai"))
            rem = n["reminder"] if n["reminder"] and not n["reminded"] else None
            self.bell.active = bool(rem)
            self.bell.set_tooltip_text(tr("Diingatkan {when}").format(when=fmt_reminder(rem)) if rem else tr("Pengingat"))
            self.bell.queue_draw()
            self.refresh_progress()
            if n["images"] != self._img_names:
                self._build_images(n)
            self.bg.queue_draw()

        def refresh_progress(self):
            n = store.get(self.nid)
            done, total = checklist_progress(n["text"]) if n else (0, 0)
            self.progress.set_text(f"☑ {done}/{total}" if total else "")

        # ---- gambar ----
        def _build_images(self, n):
            self._img_names = list(n["images"])
            for c in self.img_box.get_children():
                c.destroy()
            for name in n["images"]:
                path = os.path.join(store.images_dir(), name)
                ev = Gtk.EventBox()
                ev.set_tooltip_text(tr("Klik untuk membuka · klik kanan untuk opsi"))
                img = None
                if GdkPixbuf is not None:
                    try:
                        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 120, 72, True)
                        img = Gtk.Image.new_from_pixbuf(pix)
                    except GLib.Error:
                        img = None
                if img is None:
                    img = Gtk.Label(label="🖼 " + name[-12:])
                ev.add(img)
                ev.connect("button-press-event", lambda _w, e, nm=name: self._image_click(nm, e))
                self.img_box.pack_start(ev, False, False, 0)
            has = bool(n["images"])
            self.img_scroll.set_visible(has)
            self.img_scroll.set_size_request(-1, 80 if has else -1)
            child = self.img_scroll.get_child()   # viewport bawaan ScrolledWindow
            if child is not None:
                child.show_all()

        def _image_click(self, name, ev):
            path = os.path.join(store.images_dir(), name)
            if ev.button == 1:
                try:
                    Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(path, None), None)
                except GLib.Error as e:
                    log(f"gagal membuka gambar: {e}")
            elif ev.button == 3:
                menu = Gtk.Menu()
                for label, cb in ((tr("Buka"), lambda: Gio.AppInfo.launch_default_for_uri(
                                      GLib.filename_to_uri(path, None), None)),
                                  (tr("Salin gambar"), lambda: self._copy_image(path)),
                                  (tr("Hapus gambar"), lambda: self.ctl.remove_image(self.nid, name))):
                    mi = Gtk.MenuItem(label=label)
                    mi.connect("activate", lambda _m, c=cb: c())
                    menu.append(mi)
                self._popup(menu, ev)
            return True

        def _copy_image(self, path):
            if GdkPixbuf is None:
                return
            try:
                Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_image(GdkPixbuf.Pixbuf.new_from_file(path))
            except GLib.Error:
                pass

        def _popup(self, menu, ev=None):
            menu.show_all()
            menu.connect("deactivate", lambda m: GLib.idle_add(lambda: (m.destroy(), False)[1]))
            menu.attach_to_widget(self, None)
            menu.popup_at_pointer(ev)

        # ---- pengingat ----
        def _reminder_menu(self):
            n = store.get(self.nid)
            if not n:
                return
            menu = Gtk.Menu()
            now = time.time()
            lt = time.localtime(now)

            def at(h, m, days=0):
                t = time.localtime(now + days * 86400)
                return time.mktime((t.tm_year, t.tm_mon, t.tm_mday, h, m, 0, 0, 0, -1))

            def item(label, cb, sensitive=True):
                mi = Gtk.MenuItem(label=label)
                mi.set_sensitive(sensitive)
                mi.connect("activate", lambda *_: cb())
                menu.append(mi)

            if n["reminder"] and not n["reminded"]:
                item("⏰ " + fmt_reminder(n["reminder"]), lambda: None, False)

        # ---- binding ----
        def bind(self, nid):
            n = store.get(nid)
            if not n:
                return
            self.nid = nid
            self.loading = True
            if self.split:
                title, _, body = n["text"].partition("\n")
                if self.title_setter:
                    self.title_setter(title)
                self.buffer.set_text(body)
            else:
                self.buffer.set_text(n["text"])
            self.loading = False
            self._apply_tags()
            self.show_tools()
            self.refresh()

        def refresh(self):
            n = store.get(self.nid) if self.nid else None
            if not n:
                return
            font = store.font_of(n)
            sc = self.view.get_style_context()
            for fid in FONTS:
                sc.remove_class("f-" + fid)
            sc.add_class("f-" + font)
            if self.foot is None:
                return
            self.dots.selected = n["color"]
            self.dots.queue_draw()
            for fid in FONTS:
                self.font_btns[fid].get_style_context().remove_class("selected")
            self.font_btns[font].get_style_context().add_class("selected")
            arch = n["archived"]
            self.btn_archive.kind = "unarchive" if arch else "archive"
            self.btn_archive.set_tooltip_text(tr("Keluarkan dari arsip") if arch else tr("Arsipkan"))
            self.btn_archive.queue_draw()
            self.refresh_meta()

        def refresh_meta(self):
            n = store.get(self.nid) if self.nid else None
            if n and self.foot is not None:
                self.meta.set_text(tr("diedit ") + human_time(n["updated"]))

        def show_tools(self):
            if self.foot is not None:
                self.foot.set_visible_child_name("tools")

        def focus_end(self):
            self.view.grab_focus()
            self.buffer.place_cursor(self.buffer.get_end_iter())

        def _archive(self):
            n = store.get(self.nid) if self.nid else None
            if n:
                self.ctl.archive_note(self.nid, not n["archived"])

        # ---- teks ----
        def _apply_tags(self):
            b = self.buffer
            s, e = b.get_bounds()
            b.remove_tag(self.t_title, s, e)
            b.remove_tag(self.t_done, s, e)
            b.remove_tag(self.t_link, s, e)
            for i in range(b.get_line_count()):
                ls = b.get_iter_at_line(i)
                if ls.ends_line():
                    continue
                le = ls.copy()
                le.forward_to_line_end()
                line = b.get_text(ls, le, False)
                if i == 0 and not self.split:
                    b.apply_tag(self.t_title, ls, le)
                if line.lstrip().startswith("☑"):
                    b.apply_tag(self.t_done, ls, le)
                for m in URL_RE.finditer(line):
                    a, z = ls.copy(), ls.copy()
                    a.set_line_offset(m.start())
                    z.set_line_offset(m.end())
                    b.apply_tag(self.t_link, a, z)

        def _iter_at(self, x, y):
            bx, by = self.view.window_to_buffer_coords(Gtk.TextWindowType.TEXT, int(x), int(y))
            res = self.view.get_iter_at_location(bx, by)
            if isinstance(res, tuple):
                return res[1] if res[0] else None
            return res

        def _url_at(self, it):
            if it is None or not it.has_tag(self.t_link):
                return None
            ls = it.copy()
            ls.set_line_offset(0)
            le = it.copy()
            if not le.ends_line():
                le.forward_to_line_end()
            line = self.buffer.get_text(ls, le, False)
            off = it.get_line_offset()
            for m in URL_RE.finditer(line):
                if m.start() <= off < m.end():
                    return m.group(0)
            return None

        def _hover_link(self, view, ev):
            over = self._url_at(self._iter_at(ev.x, ev.y)) is not None
            if over != self._over_link:
                self._over_link = over
                gw = view.get_window(Gtk.TextWindowType.TEXT)
                if gw is not None:
                    gw.set_cursor(Gdk.Cursor.new_from_name(gw.get_display(), "pointer" if over else "text"))
                view.set_tooltip_text(tr("Ctrl+klik untuk membuka link") if over else None)
            return False

        def paste_image(self):
            """Tempel gambar dari clipboard. True kalau ada gambar yang ditempel."""
            if not self.nid:
                return False
            clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            if not clip.wait_is_image_available():
                return False
            pix = clip.wait_for_image()
            if pix is None:
                return False
            self.ctl.add_image(self.nid, pix)
            return True

        def _text(self):
            s, e = self.buffer.get_bounds()
            body = self.buffer.get_text(s, e, True)
            if self.split:
                title = (self.title_getter() if self.title_getter else "").replace("\n", " ")
                return title + ("\n" + body if body else "")
            return body

        def external_change(self):
            """Kolom judul berubah."""
            self._changed(None)

        def _changed(self, _buf):
            if self.loading or not self.nid:
                return
            if _buf is not None:
                self._apply_tags()
            n = store.get(self.nid)
            if n is None:
                return
            old = tab_label(n["text"])
            store.update(self.nid, text=self._text())
            self.refresh_meta()
            self.ctl.note_changed(self.nid, tab_label(n["text"]) != old)

        def _line_parts(self):
            b = self.buffer
            cur = b.get_iter_at_mark(b.get_insert())
            ls = cur.copy()
            ls.set_line_offset(0)
            le = cur.copy()
            if not le.ends_line():
                le.forward_to_line_end()
            return b.get_text(ls, cur, False), b.get_text(cur, le, False), ls, cur

        def _key(self, _v, ev):
            mods = ev.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK)
            if mods:
                key = (Gdk.keyval_name(ev.keyval) or "").lower()
                if key == "v" and ev.state & Gdk.ModifierType.CONTROL_MASK:
                    clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
                    # gambar murni (screenshot, "salin gambar"): jadi lampiran; teks tetap ditempel biasa
                    if not clip.wait_is_text_available() and self.paste_image():
                        return True
                return False
            key = Gdk.keyval_name(ev.keyval) or ""
            b = self.buffer
            if b.get_has_selection():
                return False
            if key in ("Return", "KP_Enter") and not ev.state & Gdk.ModifierType.SHIFT_MASK:
                before, after, ls, cur = self._line_parts()
                m = LIST_RE.match(before + after)
                if not m or len(before) < len(m.group(1)) + len(m.group(2)) + 1:
                    return False
                nxt = continue_list(before + after)
                b.begin_user_action()
                if nxt == "" and not after.strip():
                    start = ls.copy()
                    start.forward_chars(len(m.group(1)))
                    b.delete(start, cur)
                else:
                    b.insert_at_cursor("\n" + nxt)
                b.end_user_action()
                self.view.scroll_mark_onscreen(b.get_insert())
                return True
            if key == "space":
                before, _after, ls, cur = self._line_parts()
                stripped = before.lstrip()
                if stripped in SHORTHAND:
                    indent = len(before) - len(stripped)
                    b.begin_user_action()
                    start = ls.copy()
                    start.forward_chars(indent)
                    b.delete(start, cur)
                    b.insert(start, SHORTHAND[stripped] + " ")
                    b.end_user_action()
                    return True
                return False
            if key == "BackSpace":
                before, _after, ls, cur = self._line_parts()
                m = re.match(r"^(\s*)(•|☐|☑|\d+[.)]) $", before)
                if m:
                    b.begin_user_action()
                    start = ls.copy()
                    start.forward_chars(len(m.group(1)))
                    b.delete(start, cur)
                    b.end_user_action()
                    return True
            return False

        def _click(self, view, ev):
            if ev.button != 1 or ev.type != Gdk.EventType.BUTTON_PRESS:
                return False
            it = self._iter_at(ev.x, ev.y)
            if it is None:
                return False
            url = self._url_at(it)
            if url and ev.state & Gdk.ModifierType.CONTROL_MASK:
                try:
                    Gtk.show_uri_on_window(None, url, ev.time)
                except GLib.Error as e:
                    log(f"gagal membuka link: {e}")
                return True
            ch = it.get_char()
            if ch not in ("☐", "☑"):
                return False
            ls = it.copy()
            ls.set_line_offset(0)
            if self.buffer.get_text(ls, it, False).strip():
                return False
            end = it.copy()
            end.forward_char()
            b = self.buffer
            b.begin_user_action()
            b.delete(it, end)
            b.insert(it, "☑" if ch == "☐" else "☐")
            b.end_user_action()
            return True


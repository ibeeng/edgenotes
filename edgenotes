    # ================================================================ helpers
    def rrect(cr, x, y, w, h, r):
        r = max(0.0, min(r, w / 2, h / 2))
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def note_rgb(color):
        return hex_rgb(PALETTE.get(color, PALETTE["yellow"])[1 if TH["dark"] else 0])

    def draw_card(cr, x, y, w, h, color, band=0):
        for i in range(SH, 0, -1):
            a = (0.16 if TH["dark"] else 0.10) * (1 - i / SH) ** 2
            cr.set_source_rgba(0, 0, 0, a)
            rrect(cr, x - i + 1, y - i + 3, w + 2 * i - 2, h + 2 * i - 2, 14 + i)
            cr.fill()
        rrect(cr, x, y, w, h, 14)
        cr.set_source_rgb(*note_rgb(color))
        cr.fill_preserve()
        if band:
            cr.save()
            cr.clip()
            cr.set_source_rgba(0, 0, 0, 0.07)
            cr.rectangle(x, y, band, h)
            cr.fill()
            cr.restore()
        else:
            cr.new_path()
        rrect(cr, x + 0.5, y + 0.5, w - 1, h - 1, 14)
        cr.set_source_rgba(0, 0, 0, 0.10 if not TH["dark"] else 0.35)
        cr.set_line_width(1)
        cr.stroke()

    def region_from(rects):
        return cairo.Region([cairo.RectangleInt(int(x), int(y), max(1, int(w)), max(1, int(h)))
                             for x, y, w, h in rects]) if rects else cairo.Region()

    def setup_transparent(win):
        screen = win.get_screen()
        visual = screen.get_rgba_visual()
        win.composited = bool(visual and screen.is_composited())
        if visual:
            win.set_visual(visual)
        win.set_app_paintable(True)
        win.get_style_context().add_class("en-transparent")

        def clear(_w, cr):
            cr.set_operator(cairo.OPERATOR_SOURCE)
            cr.set_source_rgba(0, 0, 0, 0)
            cr.paint()
            cr.set_operator(cairo.OPERATOR_OVER)
            return False
        win.connect("draw", clear)

    def primary_monitor():
        display = Gdk.Display.get_default()
        return display.get_primary_monitor() or display.get_monitor(0)

    class Tween:
        """Animasi berbasis frame clock; callback dilepas saat selesai."""

        def __init__(self, widget, setter, value=0.0, ease=True):
            self.widget, self.setter = widget, setter
            self.ease = ease
            self.value = self.target = value
            self._id = 0

        def to(self, target, ms=180):
            if self._id and abs(target - self.target) < 1e-6:
                return
            self.start, self.target = self.value, target
            self.dur = max(1, ms) * 1000
            self.t0 = None
            if abs(self.start - target) < 1e-6:
                self.set(target)
                return
            if not self._id:
                self._id = self.widget.add_tick_callback(self._tick)

        def set(self, v):
            if self._id:
                self.widget.remove_tick_callback(self._id)
                self._id = 0
            self.value = self.target = v
            self.setter(v)

        def _tick(self, _w, clock):
            now = clock.get_frame_time()
            if self.t0 is None:
                self.t0 = now
            p = min(1.0, (now - self.t0) / self.dur)
            e = 1 - (1 - p) ** 3 if self.ease else p
            self.value = self.start + (self.target - self.start) * e
            self.setter(self.value)
            if p >= 1.0:
                self._id = 0
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE

    class IconButton(Gtk.DrawingArea):
        """Ikon digambar sendiri — tidak tergantung tema ikon sistem."""

        def __init__(self, kind, on_click, size=24, tooltip=None):
            super().__init__()
            self.kind, self.on_click = kind, on_click
            self.hover = False
            self.active = False
            self.set_size_request(size, size)
            self.set_valign(Gtk.Align.CENTER)
            if tooltip:
                self.set_tooltip_text(tooltip)
            self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                            Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
            self.connect("draw", self._draw)
            self.connect("enter-notify-event", lambda *_: self._hov(True))
            self.connect("leave-notify-event", lambda *_: self._hov(False))
            self.connect("button-press-event", lambda *_: True)
            self.connect("button-release-event", self._release)

        def _hov(self, v):
            self.hover = v
            self.queue_draw()
            return False

        def _release(self, _w, ev):
            if ev.button == 1 and self.hover:
                self.on_click()
            return True

        def _draw(self, _w, cr):
            w, h = self.get_allocated_width(), self.get_allocated_height()
            cx, cy, r = w / 2, h / 2, min(w, h) / 2
            dark = TH["dark"]
            if self.hover:
                cr.set_source_rgba(*((1, 1, 1, 0.14) if dark else (0, 0, 0, 0.09)))
                cr.arc(cx, cy, r, 0, 2 * math.pi)
                cr.fill()
            base = (0.93, 0.93, 0.93) if dark else (0.17, 0.17, 0.17)
            cr.set_source_rgba(*base, 0.85 if self.hover else 0.55)
            cr.set_line_width(1.5)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_line_join(cairo.LINE_JOIN_ROUND)
            s = r * 0.95
            k = self.kind
            if k == "trash":
                cr.move_to(cx - s * .55, cy - s * .42); cr.line_to(cx + s * .55, cy - s * .42)
                cr.move_to(cx - s * .18, cy - s * .42); cr.line_to(cx - s * .14, cy - s * .58)
                cr.line_to(cx + s * .14, cy - s * .58); cr.line_to(cx + s * .18, cy - s * .42)
                cr.move_to(cx - s * .42, cy - s * .30); cr.line_to(cx - s * .34, cy + s * .58)
                cr.line_to(cx + s * .34, cy + s * .58); cr.line_to(cx + s * .42, cy - s * .30)
                cr.move_to(cx - s * .12, cy - s * .15); cr.line_to(cx - s * .10, cy + s * .42)
                cr.move_to(cx + s * .12, cy - s * .15); cr.line_to(cx + s * .10, cy + s * .42)
                cr.stroke()
            elif k in ("archive", "unarchive"):
                cr.rectangle(cx - s * .58, cy - s * .52, s * 1.16, s * .32)
                cr.move_to(cx - s * .48, cy - s * .2); cr.line_to(cx - s * .48, cy + s * .52)
                cr.line_to(cx + s * .48, cy + s * .52); cr.line_to(cx + s * .48, cy - s * .2)
                if k == "archive":
                    cr.move_to(cx - s * .18, cy + s * .05); cr.line_to(cx + s * .18, cy + s * .05)
                else:
                    cr.move_to(cx, cy + s * .38); cr.line_to(cx, cy - s * .02)
                    cr.move_to(cx - s * .16, cy + s * .14); cr.line_to(cx, cy - s * .02)
                    cr.line_to(cx + s * .16, cy + s * .14)
                cr.stroke()
            elif k == "popout":
                cr.move_to(cx + s * .1, cy - s * .5); cr.line_to(cx - s * .5, cy - s * .5)
                cr.line_to(cx - s * .5, cy + s * .5); cr.line_to(cx + s * .5, cy + s * .5)
                cr.line_to(cx + s * .5, cy - s * .1)
                cr.move_to(cx - s * .05, cy + s * .05); cr.line_to(cx + s * .6, cy - s * .6)
                cr.move_to(cx + s * .2, cy - s * .6); cr.line_to(cx + s * .6, cy - s * .6)
                cr.line_to(cx + s * .6, cy - s * .2)
                cr.stroke()
            elif k == "dock":
                cr.move_to(cx + s * .55, cy - s * .6); cr.line_to(cx + s * .55, cy + s * .6)
                cr.move_to(cx - s * .55, cy); cr.line_to(cx + s * .3, cy)
                cr.move_to(cx + s * .02, cy - s * .28); cr.line_to(cx + s * .3, cy)
                cr.line_to(cx + s * .02, cy + s * .28)
                cr.stroke()
            elif k == "close":
                a = s * .38
                cr.move_to(cx - a, cy - a); cr.line_to(cx + a, cy + a)
                cr.move_to(cx + a, cy - a); cr.line_to(cx - a, cy + a)
                cr.stroke()
            elif k == "back":
                cr.move_to(cx + s * .15, cy - s * .38); cr.line_to(cx - s * .2, cy)
                cr.line_to(cx + s * .15, cy + s * .38)
                cr.stroke()
            elif k == "palette":
                for (dx, dy), c in zip(((-.3, .18), (.3, .18), (0, -.32)), ("pink", "blue", "yellow")):
                    cr.set_source_rgb(*hex_rgb(PALETTE[c][0]))
                    cr.arc(cx + dx * s, cy + dy * s, s * .3, 0, 2 * math.pi)
                    cr.fill_preserve()
                    cr.set_source_rgba(*base, 0.5)
                    cr.set_line_width(1)
                    cr.stroke()
            elif k == "font":
                layout = self.create_pango_layout("Aa")
                layout.set_font_description(Pango.FontDescription("Serif Bold 9"))
                tw, th = layout.get_pixel_size()
                cr.move_to(cx - tw / 2, cy - th / 2)
                PangoCairo.show_layout(cr, layout)
                cr.new_path()  # buang titik sisa supaya tidak ada garis nyasar
            elif k == "pin":
                cr.save()
                cr.translate(cx, cy)
                cr.rotate(math.pi / 4)
                cr.rectangle(-s * .22, -s * .62, s * .44, s * .5)
                cr.move_to(-s * .42, -s * .12); cr.line_to(s * .42, -s * .12)
                cr.move_to(0, -s * .12); cr.line_to(0, s * .62)
                cr.restore()
                if self.active:
                    cr.fill_preserve()
                cr.stroke()
            elif k == "bell":
                cr.move_to(cx - s * .5, cy + s * .32)
                cr.curve_to(cx - s * .36, cy + s * .2, cx - s * .38, cy - s * .05, cx - s * .36, cy - s * .18)
                cr.arc(cx, cy - s * .16, s * .36, math.pi, 2 * math.pi)
                cr.curve_to(cx + s * .38, cy - s * .05, cx + s * .36, cy + s * .2, cx + s * .5, cy + s * .32)
                cr.close_path()
                if self.active:
                    cr.fill_preserve()
                cr.stroke()
                cr.arc(cx, cy + s * .46, s * .1, 0, 2 * math.pi)
                cr.fill()
                cr.move_to(cx, cy - s * .52); cr.line_to(cx, cy - s * .62)
                cr.stroke()
            elif k == "more":
                for dx in (-.42, 0, .42):
                    cr.arc(cx + dx * s, cy, s * .09, 0, 2 * math.pi)
                    cr.fill()
            elif k == "grip":
                cr.set_line_width(1.2)
                for i in (0, 1, 2):
                    o = s * (0.15 + 0.3 * i)
                    cr.move_to(cx + s * .6 - o, cy + s * .6); cr.line_to(cx + s * .6, cy + s * .6 - o)
                cr.stroke()
            return True

    class ColorDots(Gtk.DrawingArea):
        D, GAP = 13, 5

        def __init__(self, on_pick):
            super().__init__()
            self.on_pick = on_pick
            self.selected = "yellow"
            self.hover = -1
            self.set_size_request(len(COLORS) * (self.D + self.GAP), self.D + 6)
            self.set_valign(Gtk.Align.CENTER)
            self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.POINTER_MOTION_MASK |
                            Gdk.EventMask.LEAVE_NOTIFY_MASK)
            self.connect("draw", self._draw)
            self.connect("motion-notify-event", lambda _w, ev: self._set_hover(self._idx(ev.x)))
            self.connect("leave-notify-event", lambda *_: self._set_hover(-1))
            self.connect("button-press-event", self._press)

        def _idx(self, x):
            i = int(x // (self.D + self.GAP))
            return i if 0 <= i < len(COLORS) else -1

        def _set_hover(self, i):
            if i != self.hover:
                self.hover = i
                self.set_tooltip_text(tr(COLOR_NAMES[COLORS[i]]) if i >= 0 else None)
                self.queue_draw()
            return False

        def _press(self, _w, ev):
            i = self._idx(ev.x)
            if ev.button == 1 and i >= 0:
                self.selected = COLORS[i]
                self.queue_draw()
                self.on_pick(COLORS[i])
            return True

        def _draw(self, _w, cr):
            h = self.get_allocated_height()
            for i, c in enumerate(COLORS):
                cx = i * (self.D + self.GAP) + self.D / 2 + 1
                r = self.D / 2 + (1 if i == self.hover else 0)
                cr.set_source_rgb(*hex_rgb(PALETTE[c][0]))
                cr.arc(cx, h / 2, r, 0, 2 * math.pi)
                cr.fill_preserve()
                sel = c == self.selected
                light = TH["dark"]
                cr.set_source_rgba(*((1, 1, 1) if light else (0, 0, 0)), 0.7 if sel else 0.2)
                cr.set_line_width(2 if sel else 1)
                cr.stroke()
            return True

    def flat_button(label, cb, tooltip=None, classes=()):
        b = Gtk.Button(label=label)
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.set_can_focus(False)
        b.set_valign(Gtk.Align.CENTER)
        sc = b.get_style_context()
        sc.add_class("en-flat")
        for c in classes:
            sc.add_class(c)
        if tooltip:
            b.set_tooltip_text(tooltip)
        b.connect("clicked", lambda *_: cb())
        return b


            row = lb.get_row_at_y(y)
            idx = row.get_index() if row is not None else len(store.all_tabs()) - 1
            if store.move(nid, idx, scope="all"):
                self.ctl.save_now()
                self.ctl.edge.relayout()
                self.refresh()


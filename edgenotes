        @staticmethod
        def _draw_swatch(w, cr, color):
            rrect(cr, 0, 0, w.get_allocated_width(), w.get_allocated_height(), 3)
            cr.set_source_rgb(*hex_rgb(PALETTE[color][0]))
            cr.fill()
            return True

        @staticmethod
        def _draw_handle(w, cr):
            h = w.get_allocated_height()
            cr.set_source_rgba(*((1, 1, 1, 0.45) if TH["dark"] else (0, 0, 0, 0.35)))
            for i in range(3):
                for j in range(2):
                    cr.arc(2.5 + j * 5, h / 2 - 6 + i * 6, 1.4, 0, 2 * math.pi)
                    cr.fill()
            return True


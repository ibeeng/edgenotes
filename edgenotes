def exe_path():
    w = shutil.which("edgenotes")
    if w:
        return w
    return os.path.abspath(sys.argv[0])


def autostart_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "autostart", "edgenotes.desktop")


def autostart_enabled():
    return os.path.exists(autostart_path())


def set_autostart(on):
    p = autostart_path()
    if on:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w", encoding="utf-8") as f:
            f.write("[Desktop Entry]\nType=Application\nName=EdgeNotes\n"
                    f"Exec={exe_path()}\nIcon=edgenotes\nTerminal=false\n"
                    "X-GNOME-Autostart-enabled=true\nX-GNOME-Autostart-Delay=2\n")
    elif os.path.exists(p):
        os.unlink(p)



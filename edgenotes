def gnome_shortcuts(install=True):
    """Daftarkan shortcut global lewat GNOME Settings (jalan di X11 & Wayland)."""
    try:
        import gi
        from gi.repository import Gio
    except ImportError:
        return False, tr("PyGObject tidak ada")
    src = Gio.SettingsSchemaSource.get_default()
    if not src or not src.lookup(GNOME_KEYS, True):
        return False, (tr("Desktop ini bukan GNOME/Ubuntu. Tambahkan shortcut manual ke perintah: ")
                       + ", ".join(f"edgenotes {a}" for _, _, a, _ in SHORTCUTS))
    mk = Gio.Settings.new(GNOME_KEYS)
    paths = [p for p in mk.get_strv("custom-keybindings") if "/edgenotes-" not in p]
    if install:
        exe = exe_path()
        for slug, name, arg, binding in SHORTCUTS:
            path = GNOME_KB_PATH.format(slug)
            kb = Gio.Settings.new_with_path(GNOME_KEYS + ".custom-keybinding", path)
            kb.set_string("name", tr(name))
            kb.set_string("command", f"{exe} {arg}")
            kb.set_string("binding", binding)
            paths.append(path)
    mk.set_strv("custom-keybindings", paths)
    Gio.Settings.sync()
    if install:
        return True, tr("Shortcut terpasang: ") + ", ".join(
            f"{b.replace('<Super>', 'Super+').replace('<Alt>', 'Alt+').upper()} ({tr(n).split(': ')[1]})"
            for _, n, _, b in SHORTCUTS)
    return True, tr("Shortcut EdgeNotes dihapus.")


